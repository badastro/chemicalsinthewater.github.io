<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="6">

  <DocumentRef DateTime="20250602T224137" id="20c2f645-008d-4f96-9d6d-6179d0a77622">
    <XRef DateTime="20250510T005519" id="354b9a51-0b00-48b9-8778-06380c3c1a44"/>
    <XRef DateTime="20250528T101536" id="00164a78-ad41-4ad5-a0bd-f4c793057482"/>
  </DocumentRef>

  <Content>
    <Paragraph Label="Scene 1" Type="New Act" id="03254032-ba6b-4137-a15f-5226dbf7d214">
      <Text>Scene 1</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="987c3cbc-adb0-4eed-895f-9c2ec73d05c3">
      <SceneProperties Length="1/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Train</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="93d78288-cd47-42a1-bc05-4a7a4a908f37">
      <SceneProperties Length="1 1/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BENZENE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="BENZENE &amp; VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CONDUCTOR">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline+AllCaps">1. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">I Need a Break</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="79621969-d8c4-48e3-8a84-1fee599aa112">
      <Text Style="AllCaps">Benzene</Text>
      <Text> and</Text>
      <Text Style="AllCaps"> Vinyl</Text>
      <Text> sit in different areas of the train, passing Ohio.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="60402845-d5d9-48b9-9228-5d69ea97b4db">
      <Text>Benzene &amp; Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="95ffd504-270a-4c40-bced-ca49ca9804e8">
      <Text>Oh no...
I will not stop to say goodbye to the state of ohio...</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="206983fd-9edc-455c-a082-b9cb6899d476">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="cfbdb5bc-4d68-41a9-8b61-0432f2700720">
          <Text>Benzene</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="2f6c97e3-8d51-4d23-875a-f61c705ec3cd">
          <Text>I cannot wait to just end my career.
I have stated this enough.</Text>
        </Paragraph>
        <Paragraph Type="Character" id="efd5f932-8c50-4ae2-8af1-eab75d4ffea5">
          <Text>Vinyl</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="8a63efe7-e63c-4985-b88b-f9c177d0dbc2">
          <Text>I cannot wait to just start my career.
I do not state this enough.</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="0e3ea271-dc38-4804-941c-a5c31bbba4da">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="ba63429a-e69c-4064-8765-a4faa22a6c9e">
      <Text>Magazines...
I will not write for you no more.
I cannot make these long hours.
I will never ever let that break me.
Life will never let this break me.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6837576d-e93e-4653-971b-029bb0e67be9">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> shows off their </Text>
      <Text AdornmentStyle="-1">PVC</Text>
      <Text> guitar.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="539500ec-7794-4357-a2d6-ecb57866b0e0">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="aa3d9c93-c40c-4782-a486-3f6849e6a861">
      <Text>Musicians...
I am honored to join your ranks.
I’m writing new hits on long tours.
I will open up my life with a big break.
Life will open with a big break!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="966e679f-9161-416a-89db-ff0766eabe22">
      <Text Style="AllCaps">Benzene</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text> grow aware of one another.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="28eb91b1-8a73-44f6-87e8-4d4fd5f628cd">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="3b5c0606-a8b7-4153-ac38-b5f496863c9b">
          <Text>Benzene</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="9905ccfe-db07-4541-90e7-62b2f8ba161e">
          <Text>I need a </Text>
          <Text AdornmentStyle="-1">friggin</Text>
          <Text>’ break.
A fucking big break.
Let me break it down for you:
I need a break!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="11d23b82-6c0a-439c-b777-7578410c4923">
          <Text>Vinyl</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="b5f48fd4-c820-47a6-81a0-3914af8f58da">
          <Text>I earn a biggest break.
A </Text>
          <Text AdornmentStyle="-1">friggin</Text>
          <Text>’ big break.
Let me break it down for you:
I’ll get the break!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="5d952df6-0412-4f71-a538-a322851932bc">
      <Text Style="AllCaps">Benzene</Text>
      <Text> joins </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text>’s seat.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="131be686-1cf7-43d2-b886-9837cf2b2197">
      <Text>Conductor (V.o.)</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="d1f03380-4995-4550-bc12-99b94064a9b0">
      <Text>Emergency brakes!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6d9b825f-3730-42f5-a407-6d692c9b276e">
      <Text>The train destructively derails into a river.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="ac2e0cfc-aa24-4c8d-bd99-aa1e1d38e815">
      <Text Style="Underline">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">I Need a Break</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="dcf9930e-2489-4aab-9834-c7d9d09daa52">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="6ecbabc3-795f-4fc3-ad4b-c78550b05542">
          <Text>Benzene</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="440a28b2-d85a-4725-b94b-22df62cd398b">
          <Text>Y’all need a break.</Text>
        </Paragraph>
        <Paragraph Type="Character" id="87a36747-41e2-4c70-8678-fa2fc303ebb9">
          <Text>Vinyl</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="6e3860b9-d9fe-40f2-b22c-f00d3316cd3e">
          <Text>I will break you!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="9cfd625f-6572-4ac0-a496-9dab2b248d32">
      <Text>Conductor (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="047016af-bb68-4da3-8eea-399af594a119">
      <Text>Thank you, Benzene. Fuck you, Vinyl. I hear you from the front car. Your lyrics moved me more than trains ever could. I need a break. A permanent one. But before I go, here is a message from the Governor of Ohio.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="f0ad50e8-e4fc-4a4e-8919-3453d1aa85dd">
      <SceneProperties Length="1" Page="2" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BENZENE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="BENZENE &amp; VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="HYDROXYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline+AllCaps">2. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">No Agency (NO Further Assistance Needed)</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7a2f9354-77c8-445d-9e20-625adc043982">
      <Text>Hydroxyl (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c4a05779-af11-4a41-a200-ee7349ab79e9">
      <Text>Sorry, not sorry your plans are derailed. The federal government has failed you. They have no agency. Despite that, the local government will not fail you. The </Text>
      <Text AdornmentStyle="-1">EPA</Text>
      <Text>, or East Palestine Authorities, will cheer you on. I am Hydroxyl, your esteemed Governor of Ohio. Your godsend.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="cc1d3871-d631-4e7b-b0a0-4b254649f09f">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="54056feb-2e52-4981-8ebe-0bec4d6ade3f">
          <Text>Benzene</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="ebc79e34-7dab-46a0-9ed1-98d3145f2dbf">
          <Text>Hell no.</Text>
        </Paragraph>
        <Paragraph Type="Character" id="9d01899d-f559-4eb0-85a9-70ddce164590">
          <Text>Vinyl</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="941149fb-36ce-4158-a9ec-a28cf350e7e6">
          <Text>Go to Hell!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="5896b65a-290b-44a8-847e-91a65069a3e3">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="b2fed6bc-0373-4ac9-a6df-7bc83c141342">
          <Text>Hydroxyl (V.O.)</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="cba998ed-d37e-4e4e-9439-e8d21b91a6a6">
          <Text Color="#00000000FEFE">I do not see any problems.</Text>
        </Paragraph>
        <Paragraph Type="Character" id="1d293b64-9548-41b8-bede-5b6e13adbf0f">
          <Text>Benzene</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="a2c44f38-277e-4c14-a7af-84b5cd4c05c4">
          <Text>Look in the mirror!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="b0fdc262-325e-455d-a83a-e17e81f4de4e">
      <Text>HYDROXYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="32b63031-0832-4d7b-9b63-ec123e4981d2">
      <Text>I’ll smash your face into a mirror!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="48b0c17d-13b4-4a89-a336-25d3183b5aa3">
      <Text>Hydroxyl (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f466ad22-d8a3-4dae-ae1e-85144e8dc333">
      <Text>I see solutions. Solvents in Ohio. Stay well.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="31195187-01dc-4210-980f-3ff07d46edba">
      <Text>BenZENE &amp; Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5ca3a69e-a6c0-4d2f-9a60-a2ccd41372de">
      <Text>We shall poison your well!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="909c6635-7c78-45b2-85b2-540f289e3d0e">
      <Text>Hydroxyl (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2e31f41a-8e9d-448b-a4d5-7a2a989e1705">
      <Text>I’m poised to say... There is no further assistance needed.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6fcec31c-e852-4853-9703-17df0f4f6eb9">
      <Text>The intercom hangs up.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="cd60da1a-b704-4439-84b7-64ac065ae916">
      <Text Style="Underline">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">No Agency (NO Further Assistance Needed)</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d54bfafd-9bb6-49a4-8b81-dfadaab1d1ae">
      <Text>Benzene &amp; Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1fe6e756-e0b5-4aeb-b787-4de39eca297c">
      <Text>We need you!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e8ea751c-53e4-4c52-b55d-2acd4b84c912">
      <Text>Hydroxyl (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1b711109-3ec0-4863-b426-fc27eaa453e9">
      <Text>Tough shit!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="02c51671-9b20-48b7-b27a-a2397b84aa48">
      <Text>The intercom hangs up again.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6fd721ac-999b-4f97-8d11-28dcb73e2881">
      <Text>Awkward silence.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="8d429a80-8985-4fca-9441-17a5ce390b7a">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="33e4a509-3e7b-472a-b4eb-02a47c9fd56f">
          <Text>Vinyl</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="fc2ebcb6-bae6-45dd-8a5d-a30f6e4b2167">
          <Text>That’s it! I’m walking.</Text>
        </Paragraph>
        <Paragraph Type="Character" id="2ce70e16-6220-4940-8408-52adc28fff96">
          <Text>BENZENE</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="5609a815-63d9-4b59-b06f-30aabe83d9c7">
          <Text>More like swimming!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="ee62bb78-3102-45ed-988e-66b902a8b40f">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> opens the train door to find their train is in the Ohio River.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="c5feca47-9936-4ae9-a423-3930915259b5">
      <Text Style="Bold+Underline+AllCaps">Scene 2</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="b20c0fab-1250-4af5-9ad9-37cf8ddb922d">
      <SceneProperties Length="4" Page="3" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BENZENE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Ohio River</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e6dc111b-f4ee-4f28-9fff-3a8b048755a7">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d03aba9e-7372-44e5-b2dc-9dca22f52108">
      <Text>Oh shit oh.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="89f7ac9b-9ddc-4e00-b948-d7140559e8fb">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="06fa72b9-68b9-41f3-ab4e-660e1cf64a4a">
      <Text Style="Italic">Ohio River</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f31ea8f3-f48f-41c0-98a4-39616405a4b7">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="569b9b1e-f2dd-49cb-94d5-8298a6d00e7b">
      <Text>Fucking dihydrogen monoxides. Always getting into everything.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8ebddb8c-2f4f-4b71-b22e-e0f0284990d0">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9c72c60e-26c7-4f01-8722-e2ce67c5a33c">
      <Text>You’re so reactive.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="865d5e69-5c59-4249-b155-3b7981ed2afe">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d0b7a3cd-8621-4fef-9445-31ac59725065">
      <Text>Fuck I am. Why aren’t you?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ee13c093-484e-45e4-b1b6-ae834520724b">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ffa756be-31cd-49c4-90fd-799773ad6617">
      <Text>It’s not in my blood.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e0da7886-5d77-48c6-bc9f-0d0ae9a75567">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="35f189ee-728b-4cfa-90a6-8079550f19ec">
      <Text>Well, Chloride is in mine.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e40e9f4a-796b-4951-ba93-70e6d92e5a4e">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="df11d23f-a07c-44bf-97a1-f17d4ca06ded">
      <Text>Chloride...?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d5c294f0-c34f-494d-9ee7-e61ccd22201e">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3aa49658-e21e-4f20-87a0-eac3499f8e01">
      <Text Style="Italic">You</Text>
      <Text>’</Text>
      <Text Style="Italic">ve seen those vans around</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="76ed0635-0718-4c53-9021-9ac2d73321a1">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="95c3ae23-20a3-4c21-8678-f7a6ffb9118e">
      <Text>Oh! Are you a </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">PVC</Text>
      <Text Style="Italic"> and the Chlorides</Text>
      <Text> employee?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3a11f75d-71a6-4cca-ae0c-90bb206825ef">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="edc31b58-c862-493d-8a6f-a10d038b3c3c">
      <Text Style="Italic">I’m a member of the Chloride family</Text>
      <Text>, a proud and hardworking supplier for plumbers and electricians everywhere.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d66638b3-b93c-4456-b0ff-e0b367e6a53f">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0523a01d-87f7-4891-81d1-650d35ea1f34">
      <Text>How long have you been apprenticing for the family business?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3a12f0e8-efc8-4a6e-85b7-18dcc2801a4a">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c27af731-4200-44c4-a20d-8443feaba9d3">
      <Text>No longer am.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0032cdc1-a992-4a7e-9428-20597c490d5d">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9e74c206-87c1-4791-be48-a8a79aaab7b8">
      <Text>How come?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="260bde51-ceab-4dc1-bb69-33d4828e378a">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c0b6a6e7-abcb-46b1-bc51-89c43491bc0f">
      <Text>Instead of fitting pipes in, I keep busting them out.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="04535c67-ea01-4538-b6ef-e0ba77795adb">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> pulls out </Text>
      <Text AdornmentStyle="-1">PVC</Text>
      <Text> pipes.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2676de9a-f908-40f2-9308-5d947c201edf">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dd3624ef-fc1e-4ee2-82c0-88c898353c91">
      <Text>A renaissance Chemical... </Text>
    </Paragraph>
    <Paragraph Type="Character" id="baa717c7-1863-4177-98bc-75e1f478bfd5">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8e7ed774-60f3-4a83-b742-a98602684a7f">
      <Text>Pipe down.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9874c641-af9c-4fb8-9436-1fd1cb8bc6fb">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> drums with the </Text>
      <Text AdornmentStyle="-1">PVC</Text>
      <Text> pipes.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="de4c304d-fa97-42de-856d-576e4f49c83a">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="84751cbc-29c1-441d-bc9b-6b30dcfa0891">
      <Text>You artists dream pipe dreams.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2d76e299-473c-415d-8970-0b744bff958a">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4cb620da-892e-4e33-9531-eb4b629dfb74">
      <Text>A pipe dream that’ll burst into reality soon!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e7fadd74-eed2-4f6f-aa24-346903859813">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> blows into the </Text>
      <Text AdornmentStyle="-1">PVC</Text>
      <Text> pipes.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0d38f997-d125-4f7d-8ac3-672f2f68b8f4">
      <Text>An </Text>
      <Text Style="AllCaps">eagle</Text>
      <Text> cries in the distance.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="00687be6-d563-4de5-aa4a-3a4fe918dfd5">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b773aa06-7615-4acb-a125-3e735920f936">
      <Text>That’s a sign...?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="36aa2bb2-9282-4796-985f-16be3208cad8">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="70b18150-809d-4105-8d51-bb7d1d69e775">
      <Text>What’s yours?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="049996a7-0969-4635-b556-361fab1afb37">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7f3a885b-d0b9-4200-a9b6-711d360a4545">
      <Text>Excuse me?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2f2e25cf-95fb-4524-bcbf-a19c68fb1e30">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="713cbb69-bfb3-4dfa-baa1-70b6ff1ead9c">
      <Text>You seem like a type.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="36278e2f-4f62-45a3-8b45-2796ad2aca7d">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="811a8131-c0b5-42e2-9b97-9cfae9000361">
      <Text>You want me to type it out for you? I’m a... </Text>
      <Text Color="#00000000FEFE">C2H3Cl</Text>
      <Text>...?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="11ca66f6-8c65-4b98-a5a2-3734d6aed358">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d7e5dc04-9692-4bda-8852-9eea37b9f015">
      <Text>Not what I mean. You’re certainly not my type.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ad214330-b765-473b-abcf-dffc4fc1618e">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="05f6c7f1-3d98-46b6-ba52-6d4899913596">
      <Text>I see through you, flammable </Text>
      <Text Color="#00000000FEFE">C6H6</Text>
      <Text> types. Ya skin’s rubber, ain’t far from plastic surgery.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="45bf89a8-e7d4-4d1d-9973-d17d686e2cbf">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0f7ac601-cdc4-45fe-98cf-7104354486ca">
      <Text>You’re one to talk. You need to keep that musician image. Can I play your </Text>
      <Text AdornmentStyle="-1">PVC</Text>
      <Text> guitar?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4a8a3d56-1f2a-42d7-a837-5c8d83e7f9a4">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8df45504-7dcd-419a-9831-962ebd4bbc01">
      <Text>You can play with my pipe.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4a011565-7a93-4634-8d7b-1ca7c58f5c5a">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="537ba571-0a18-43ca-9e2e-0ded3264dde3">
      <Text>Ew no. It’s probably been somewhere.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="93b579d4-1479-42c1-900c-f2a010f85209">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="19d15c50-af76-4a6b-9033-8eba8fe41f09">
      <Text>No shit. It toured all over Wayne County from the Armageddon </Text>
      <Text AdornmentStyle="-1">Beachparty</Text>
      <Text> Lounge to the Olympus Theater in </Text>
      <Text AdornmentStyle="-1">Menjos</Text>
      <Text> Complex, Detroit.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d4f8f9ae-690d-4a08-9bac-1b8c0453d1fe">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="efd5b71a-9f85-40a2-83c1-b3d243dc5a78">
      <Text Style="Italic">Sure</Text>
      <Text>. May I at least hold your guitar?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="70d22490-d781-46b0-b9f9-12a8c393f261">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d1c631f8-deed-4010-b8d5-ad6dbf299cfe">
      <Text>Nah uh.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ebd42be1-91f2-46e6-a6e4-bb4f3ff51df2">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b438b4ed-d521-46a0-bd71-1af7a8f3553f">
      <Text>You’re no </Text>
      <Text Color="#00000000FEFE">Serotonin</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="14960932-9a6f-490f-951f-1497a562d222">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ddcca6f3-9dab-4624-989e-868391668c8c">
      <Text>I dated a Serotonin once. Such a toxic bitch. But ain’t toxic enough for me. Serotonin is in the Detroit music scene, writing dopey love songs. That Chemical is immeasurable.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bad7c67d-dd9a-43f9-a6e7-3e0a21c53b69">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="224682d0-53b7-48a5-8e7b-222675a8cacd">
      <Text>You’re immeasurable.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4f562b55-822e-4c2d-b0be-2cc53ea178a9">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b1fc14c3-9fcf-483a-a545-1ca583437fd1">
      <Text>We sure are not. I’m no </Text>
      <Text Color="#00000000FEFE">Phenethylamine</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f60fdfcf-035a-44f6-a46d-b9f3b216f0b0">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3c7cf176-cf19-43e5-a063-42e3f489acf0">
      <Text>Have you written one?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4904896c-3138-4a9f-b2de-a68cf111ea8c">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d4335307-eb7b-4bf5-b6b4-0ec6d10d98db">
      <Text>What?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="76279b3d-1b8f-40d6-ace0-e23c4a2c711b">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2c053b9f-44c6-4ad6-a394-8d42d886ee8b">
      <Text>A love song?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d8c827da-7d05-46c3-9371-e9dbb8a5cea9">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="af0a6625-f93b-490d-bdf8-1d769283642e">
      <Text>Wouldn’t dream of it...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="62157a53-1345-41f9-9a26-3491de4967cf">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="199ae1b6-75f7-4d12-882c-db23b12513f0">
      <Text>How about a hate song?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="19f45e8a-623b-44b3-87d0-18dd98292a03">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5f0dd2b9-5837-4004-ad73-218498e3eb3d">
      <Text>Now this Chemical’s talkin’.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="05a08a3e-0276-4213-a822-c24f886f7331">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b194fb5b-fd65-43aa-9959-fea3a3d610b3">
      <Text>I can sing, too...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="63c2e6b1-afce-4668-bda7-733006621681">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> hands the guitar to </Text>
      <Text Style="AllCaps">Benzene</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7bb66f36-8aff-4773-af46-60a612dd4138">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7b3670df-dac7-4ab6-9cc1-fe1c2ebfeacd">
      <Text>What do you hate?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1e274897-4563-4ca3-8115-6aab6de7f2d5">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="b00150e7-dee9-4f52-b035-686c99666c94">
      <Text>(Erratically strumming)</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="7dd96825-77e1-45e0-85d2-636bc51b5171">
      <Text>Michigan!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="19396e58-649a-42df-8562-421221209ce7">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> takes back the guitar.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ad2e6534-efa5-4831-907a-6d920269aae4">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="75dc988e-b25c-4b2f-ba19-7d453adcc41b">
      <Text>Start small!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e4b00ea3-5e6e-4671-b516-48df200d3185">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3e5df59c-58a8-4bc7-89db-68fc498b3c2c">
      <Text>Midland.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cec46a61-0b4f-4c38-a8ee-ba72a7fe417d">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6795e16f-c87d-4511-ac8e-7e0431e0b208">
      <Text>Now, what’s your reason for wanting to get out of Midland? </Text>
      <Text Style="Italic">Friend</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5558dafb-e5b7-4ecc-8941-c9abae81273d">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2a14a24d-4420-415a-ae1e-1928da97015f">
      <Text>Were you trying to get out of uh...?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3f06ffb5-47c8-4c5e-a677-71a63ab5e358">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cfd6c93d-2601-4c40-b44a-6a2362d91c59">
      <Text>Detroit. Yes, I’m getting out there. To New York. You?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0e73d662-2bbb-4237-998d-ad96db542621">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="62e37279-95ea-4aad-b19f-26ffb38dae8c">
      <Text>Oh... Anywhere.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e3138d7f-a7ea-4b2b-9dbe-68ff0af68ed6">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6df4edbf-1d82-47a1-8d91-ac48530c25bf">
      <Text>OK...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7a1670a6-075f-4339-bf80-38cd84c27675">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ce5ce8be-94e8-485d-b916-f370d0a6981b">
      <Text>Oklahoma... Definitely not there.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5f60bac7-858b-462d-9859-0420fa5b7605">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="03c686e0-34c7-4083-ac5d-b7eee67eac3e">
      <Text>The musical I get you there. But, </Text>
      <Text AdornmentStyle="-1">whatcha</Text>
      <Text> got against Michigan?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1d020d13-24ca-43e5-bf83-e6f4febe9e9c">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="49c30f71-1d57-4f2e-b8b6-5293cf22a33e">
      <Text>I’m distancing away from my work life.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="38cf031a-9d17-41b0-a5d3-ef995d823cf7">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="69a89aae-31c0-4bfb-bfbc-fdc21d335069">
      <Text>Work and life don’t rhyme together. Work and life don’t go together.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="967b3549-df81-48d8-b233-4554336babd0">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1b8e0ba8-4930-43c2-ba90-625d631a0306">
      <Text>So, Vinyl, you definitely are a musician.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9337963a-7e3a-4d0c-b8c0-d8369bbdb8cd">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="171c9c07-6ac2-41d3-b3a5-b27127477bf0">
      <Text>Shut the fuck up. What job didn’t strike a chord in you but instead a match?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="52479f68-2d6b-4f4c-b10e-f7a82c9c8c8b">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="36315ca6-1079-43ad-aaa0-12dfd84070ce">
      <Text>I was a Forest Fire Magazine editor at </Text>
      <Text Color="#00000000FEFE">Dow</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="206b5ad1-885f-453d-99a5-63f506311bb5">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="74ee33e0-b639-41ec-bc40-5bbfe4c44ee8">
      <Text>The nature magazine?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d4e508a5-34b6-4743-97d3-e9a5316f9662">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d027a43a-0519-4dbc-9d65-649a5609ff6b">
      <Text>Nature isn’t what it seems...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9ad21a06-2531-47c1-9ffd-45eaae7a9017">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="719632df-2b67-45f2-bab2-1ddae9aef91f">
      <Text>Benzene? What is your dream?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="627bd216-258b-4822-a9de-5a7d16d0da15">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c72b6138-0307-42e1-9a7b-cf42fa281c99">
      <Text>To resign to nature. And to get to know you.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="9dac539f-4074-4b9d-b1ee-7e73e685720b">
      <SceneProperties Length="2 5/8" Page="7" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BENZENE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="BENZENE &amp; VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline+AllCaps">3. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">What’s your Sign?</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="12804794-8e5e-47ff-b41e-832440cd64dd">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="e589611d-1074-477e-bd81-54dffc09ed79">
      <Text>Can I guess...
What is your sign?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a4ff08dc-28de-4fe4-be60-1434fd71f665">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="f4959446-8d70-4f78-9fc9-c85e69bf4444">
      <Text>Oh not this.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ea43f3a5-507b-465e-a6b1-31d8a6db8ccd">
      <Text>BeNZENE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="5fe690b7-3a34-4e22-9cd5-c61d11b851b9">
      <Text>Are you a...
Leo? Virgo? Libra? Scorpio? </Text>
      <Text AdornmentStyle="-1">Sagitarius</Text>
      <Text>? Capricorn? In the age of Aquarius... Pisces? Aries? Taurus? Gemini?

Let me guess...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7418be3f-830a-4fca-8184-fa302019239b">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="7fe41555-67fa-4efe-9e06-27f800e8502e">
      <Text>Astrology is a disease.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4445c7f6-c84e-4a46-aa0d-d7ee89469ba1">
      <Text>BeNZENE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="89276cc7-2350-454d-ac1c-03537299b6ea">
      <Text>It never hurt anyone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6213588d-9be6-4bec-b510-ed57720f22aa">
      <Text>BenZENE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="732f2e90-e18a-40f3-a876-2343ea6a0cd3">
      <Text>Seriously,
What is your sign?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e9fd1609-2df0-43c1-9cc5-be9f8dc72cdd">
      <Text>VinyL</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="82a23afd-e91f-4c12-94c6-62bc3f5ddee5">
      <Text>Give it a rest!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="14121e9e-5d00-4cd4-a66f-536b959ce8c3">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> confronts the band.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8daab30c-b19e-4642-84ac-49b7d3fb082d">
      <Text>VinyL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f5a34cfd-7370-46d6-8c2e-dc0dd0746e72">
      <Text>Seriously, shut the fuck up or I’ll give you all cancer! I’m the musician here!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6dadb357-008c-449a-8e33-70996b10a5d2">
      <Text>BenZENE</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="92214c7e-9211-4b2c-ba67-81a530e986fc">
      <Text>(to the band)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fe11d0bc-9b86-42d0-98af-3916f48f41c1">
      <Text>Pardon my fellow carcinogen. Sorry you’re stuck on this train with us.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="2d2acdbe-e5d1-4bc7-a1c7-36e20aeca0b0">
      <Text>(to </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="56fd98a7-111f-4c23-8020-95ef4b617eb0">
      <Text>I’m also a cancer! But, you don’t give off nurturing vibes...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ad2980e9-7fa5-4433-adfc-e8160c97fb1c">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="21856d95-5076-4bf2-9cc6-ae0bf5acc53a">
      <Text>Ain’t that </Text>
      <Text AdornmentStyle="-1">sump’n</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7386cb52-29a3-4daa-8a32-994aefc2871d">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="644cc151-1c52-4844-baf7-d32179b09d00">
      <Text>Cancers are empaths. Well, you sure are sensitive.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4607f31f-8cc7-4698-86f7-b23f74b2471c">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c8b99848-25b5-4a8e-bb16-797a7d77dfc8">
      <Text>As a cancer...
I do nurture...
These tunes and tumors
like they are my children!

No one can best me,
not asbestos
my moon rising
is blood pressure
I’m here to keep Make-a-wish foundation in business</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fa31fb75-37d8-48c8-a5c9-05bda96dbea6">
      <Text>BenzeNE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="2f15e2d1-1d16-4165-b35c-3f4dbfe34790">
      <Text>Cancers are hot.
So flammable.
Your sun rising
leads to fevers.
I’d like to</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e55eaf29-018b-4bf9-92bd-d4fd650d0fff">
      <Text>BenZENE &amp; VINYL</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="a1fe5077-b98d-4537-9482-cd7e445f82e0">
      <Text>Keep make-a-wish foundation in business!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f0f205bb-2b6e-4b98-b262-82e56952dd19">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="9becf309-e22a-49a9-9f0e-d3a6144c2320">
      <Text>Where is a sign?
Divine intervention!
I hate being stuck with
Another cancer</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0ddcc374-e91f-42b7-8fbc-60587e637bc0">
      <Text>BenZENE &amp; VINYL</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="2dfff57b-c2a5-4fa6-a40d-b03e8d2f36e1">
      <Text>Give us a sign!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8cdfce4c-e1bf-49e9-b41e-e534971d83b1">
      <Text>An empty boat drifts nearby.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="62b2facb-c83e-4b3f-be2e-d633d62f1dbf">
      <Text>BenZENE &amp; Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="60779840-6559-4170-8b4c-9eae45e23577">
      <Text>That was on time!

Cancer’s my sign.
We are cancer!
We are rising
to the occasion!
The carcinogens are now back and we mean business!

This is our sign!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="fbfe6c29-3c76-423f-8456-aaa9314ad769">
      <Text Style="Underline">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">What’s your Sign?</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="18e5e128-83ff-4bb8-b38b-6713b905be84">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7cc31237-3916-48e6-874a-1bf1f82287fc">
      <Text>We, agents of cancer, got ourselves a ride!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1a0ae4aa-9c0a-4452-839c-f35701b1656a">
      <Text>VinYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e32a9c9c-ec5c-4a76-a6e3-176332bc4cbf">
      <Text>Agents. Sounds sexy.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d8d363ad-2638-4339-8f68-36eef60f19e4">
      <Text Style="">BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d71c4985-6e42-4417-ad20-f54a0d418197">
      <Text>After that raft!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c08fff62-fcb3-470d-9bef-f5800867ba97">
      <Text Style="AllCaps">Benzene</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text> grab the boat.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8dad37fd-8491-48c3-89ff-8f865d12ce9f">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ab7f55dd-6784-4cea-ae31-62de0979618b">
      <Text>I </Text>
      <Text AdornmentStyle="-1">gotta</Text>
      <Text> admit: Ohio got some hidden treasures.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ef21af11-b439-4270-a1a5-ee4ea6999bb1">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="07a3d362-1583-4a97-b6a7-73b15a7efed4">
      <Text>Hmm... Where does this river lead to?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="034ee8e2-07c1-4c6a-8a00-9aa454233d0d">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4c5b15e7-141b-4deb-afb4-8f4d57eddfd9">
      <Text>Water usually leads to civilization!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7b354a58-8525-4ca2-8250-e1bf5c7fca25">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a3302cfa-6124-44d0-b592-62fc9f58773c">
      <Text>You see paddles anywhere?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="07429c2c-8eb1-4d82-b0e2-c6b771b35e97">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0bf7f204-ca46-400e-b9d9-11e2bf55fa82">
      <Text>We’ll let the currents take us.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c95b3a79-24bb-43a3-844e-06a4f8b70c88">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7a5c62cf-831b-4130-b165-95bc31e6e7f2">
      <Text>I hate dihydrogen monoxides...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="73d9e3cd-c1ff-4c33-a8c4-6fe422aa8798">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1edf47a8-0b0b-4582-bc76-a10130ff856d">
      <Text>Pipe up!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ed2835ab-7008-496d-b9d7-136a4250ff24">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="569b4596-6f5e-4123-9959-8a00daa7f9bb">
      <Text>You really trust nature, huh?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="69358311-c75a-4a82-9446-30e09d370529">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="577f5741-58cb-4377-9309-07df5db0321b">
      <Text>With my life.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="da312e22-0479-459b-9c90-a58dcf875cb3">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="95689aa0-0a33-4b77-b543-936d0139d50f">
      <Text>You’re such a cancer.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="84312621-648b-4cfe-bf15-8f60b29ae3ac">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.75" RightIndent="6.38" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="Dialogue" id="ecfdbd1b-ff4a-4b7a-a54c-d3e2a08f455b">
      <Text>Strum, carcinogen!</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="4948e30f-b4f4-4a21-a132-5f01e20add44">
      <Text Style="Bold+Underline+AllCaps">Scene 3</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="33ff597b-0d5e-4ded-94c8-e9ffe620870d">
      <SceneProperties Length="1/8" Page="9" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ohio River</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0056d1f0-c3d2-4bd1-91e1-3b6473d66eb7">
      <Text Style="AllCaps">Benzene</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text> sit</Text>
      <Text Size="10"> </Text>
      <Text>in</Text>
      <Text Size="10"> </Text>
      <Text>the</Text>
      <Text Size="10"> </Text>
      <Text>boat.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="03660d0d-f994-40d4-b6d5-7630731bbe71">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> strums their </Text>
      <Text AdornmentStyle="-1">PVC</Text>
      <Text> guitar before deciding to row with it.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="098166bd-6efb-4b1e-9867-2f6bdfedab4d">
      <SceneProperties Length="2 6/8" Page="9" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BENZENE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="BENZENE &amp; VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline+AllCaps">4. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Chemicals In the Water</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="bc768d56-14bb-4e9c-8663-26d24604cc6c">
      <Text Color="#00000000FEFE">All sorts of colors project upon the water and riverbed over time.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="48047b59-80bd-49d4-b2e7-8c0b4139afe3">
      <Text Style="AllCaps">Benzene</Text>
      <Text> sees eerie sheens emanate from the guitar in the water.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="fd43d954-5cec-4631-94bf-7f9d9776688c">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> feels something...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="853e0ec6-3c7f-4197-818e-2c30deb0ac02">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="0db2b58e-a835-4206-9982-ef21f0854653">
      <Text>The water’s chemistry...
It’s greater than we can ever imagine.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="43a2af0c-eb6d-4551-9c24-cdc382ce901e">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="6ab560c2-0e6f-4d0f-8aed-bc6db6959ee5">
      <Text>While our chemistry...
It is not something that I could fathom.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2e961dcd-3111-4335-9d53-fd282f9a4615">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="60624956-f246-47c4-b1c5-3255de4f009c">
      <Text>The water’s chemistry...
It’s so reactive with all its hydrogen.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="44fcb586-e8ab-41b2-9e3c-cfd54424ec12">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="1e009b29-a183-44cf-aa76-a082b001ab64">
      <Text>Oh, our chemistry...
It’s refreshing to tell you, my “friend.”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2606a8be-96d2-451b-9766-24a4be164e46">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="9bc780e1-699e-4d6a-8809-d439b4ee117a">
      <Text>Nothing’s in the </Text>
      <Text AdornmentStyle="-1">wa</Text>
      <Text>-</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ed592c1e-f09b-4a74-b7b8-30b6e7fca4da">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> pulls a dead fish out the water.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="622f3f8e-8556-460a-aa69-d595e6cf8f74">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="8f2c4ad7-e261-4ce3-a780-30863f8c9b6b">
      <Text>What I need to fish out of my soul...
This is what I now need you to know:
The colors are now altering my brain</Text>
      <Text Size="10"> </Text>
      <Text>chemistry</Text>
      <Text Size="10"> </Text>
      <Text>and</Text>
      <Text Size="10"> </Text>
      <Text>my beliefs.
Our spectrums are aligning.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9ea2a4a8-3eac-42e7-a481-40e2d92c3a44">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="01adba84-a6f5-4792-ac13-fd3dd37b86c4">
      <Text>I can’t believe you are saying this-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a762bede-4450-4bd4-93af-13faa2eff4a4">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="7b2f4b52-724e-42dc-b43f-a623f7298b12">
      <Text>There’re chemicals in the water turning my heart </Text>
      <Text Style="Bold+AllCaps">gay</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="db931b8b-78ee-4a0a-9c3e-543e1334ce55">
      <Text Style="AllCaps">Benzene</Text>
      <Text> winces, thinking "</Text>
      <Text AdornmentStyle="-1">Dafuq</Text>
      <Text>?"</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a87df436-0999-4b1b-9e65-cc7fe83fbd36">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="7fec006f-08e9-4b1f-9c5d-50a0415eec49">
      <Text>Just how gay?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b588caa5-5693-4786-8b55-d5cd76be279d">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="9f73a7e8-ba06-4fee-a81e-5778ea21ae9c">
      <Text AdornmentStyle="-1">Friggin</Text>
      <Text>’ gay!
</Text>
      <Text Size="8">
</Text>      <Text>There’re chemicals in the water turning my heart gay! So gay.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2d4fca50-d2a9-4626-a0da-b2b7ecadcb2c">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="257213e9-8463-4953-b435-3a4ae6cc379b">
      <Text>Are you okay...?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a32e1eb1-803f-4e65-8287-05d838b60feb">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="b288f3bd-f5c3-423c-9674-5517f1b174cf">
      <Text>Nope... Cause...
There’re chemicals turning the water </Text>
      <Text AdornmentStyle="-1">friggin</Text>
      <Text>’ gay!
Colorful! Just feel all this rainbow!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4d376920-ab6e-4758-ada4-1f15dfcd6930">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> grabs ahold of </Text>
      <Text Style="AllCaps">Benzene</Text>
      <Text>’s hand and have them feel the water. Naturally, benzene and water don’t mix. So through Vinyl Chloride’s action, </Text>
      <Text Style="AllCaps">Benzene</Text>
      <Text> feels the magic of water for the first time.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5ac9492e-8eec-44e6-8048-69705dc448e7">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="5986e802-e280-4c71-b5b8-6e061f1c603f">
      <Text>There’s water in my chemistry...
There’s water in me!

Okay, I need to get this off my chest.
Here’re couple gays in the same boat.
Your queerness now opens up my mind to</Text>
      <Text Size="10"> </Text>
      <Text>all</Text>
      <Text Size="10"> </Text>
      <Text>possibilities.
Our feelings are so in line.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="26a96b59-d600-4e04-a47c-ed5286bdfa60">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="87bd5b86-f039-4a79-ab22-b733a6b516b8">
      <Text>I can believe in love and science!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2c4623bf-f384-4dfb-bf97-24cec7114189">
      <Text Style="AllCaps">Benzene</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text> pull out colorful fabric under their boat. The touch of their hands into the water causes a ripple rainbow.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fe1dd3c6-5556-4877-a86c-4a314fa602eb">
      <Text>Benzene &amp; Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="816c306b-4980-432c-a2ff-5cc4d0988efc">
      <Text>There’re chemicals in the water turning our hearts gay! </Text>
      <Text AdornmentStyle="-1">Friggin</Text>
      <Text>’ gay! Queer water!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="186978b8-0cbb-4181-a80b-8accacba011c">
      <Text Style="Bold">Audience Engagement:</Text>
      <Text Style="AllCaps"> Benzene</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text> could collect water into bottles labelled “Queer Water” and toss them to the </Text>
      <Text Style="AllCaps">audience</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c7b4d634-7e24-4bf8-9731-5e98f6e164a7">
      <Text>BenZENE &amp; VINYL</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="816c306b-4980-432c-a2ff-5cc4d0988efc">
      <Text>There’re chemicals in the water turning our hearts gay!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="da8a6eaa-4f69-4286-8225-a1bd966d37ff">
      <Text Style="Bold">Audience Engagement:</Text>
      <Text Style="AllCaps"> Benzene</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text> points to what’s underneath the audience’s seats. The </Text>
      <Text Style="AllCaps">audience</Text>
      <Text> could play with the fake frogs.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d950f40a-6885-4939-aae2-d3e63656a45a">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="368e8278-1fa4-439a-a4d1-660d1631b874">
      <Text AdornmentStyle="-1">Friggin</Text>
      <Text>’ frogs!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0b0eb958-50b2-4557-b7b7-24e11c4ad969">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="7f9f78b3-f072-470d-a13e-cb3ad7a0412c">
      <Text>Gay </Text>
      <Text AdornmentStyle="-1">rippit</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8f30f1dd-35d6-40d3-87fd-fca350ecd9ee">
      <Text>Benzene &amp; Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="72ae51b9-73d3-421a-85b0-ab634cdda0d7">
      <Text>There’re chemicals in the water turning our hearts-</Text>
    </Paragraph>
    <Paragraph Type="Action" id="cce4715c-0316-4b47-acea-98ec9af790d6">
      <Text>Gay </Text>
      <Text Style="AllCaps">frogs</Text>
      <Text> jump </Text>
      <Text Style="AllCaps">Benzene</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="0bd1e655-33fa-46fb-a289-ce64f25110ad">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="b3aecc62-3b24-4513-8277-1a3580fdc3a4">
          <Text>Benzene</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="7becd90e-04eb-49aa-b5d3-6b23bad544ef">
          <Text>Gay </Text>
          <Text AdornmentStyle="-1">arse</Text>
          <Text> frogs!
End our rainbow.</Text>
        </Paragraph>
        <Paragraph Type="Character" id="b547005a-a34c-40d0-a36a-71b4e1de3108">
          <Text>Vinyl</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="c0efc387-7939-4ff7-91c1-d28ba1ae277e">
          <Text>This is so gay!
End this rainbow.</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="45200803-2d24-4ec8-b8d0-ecd2bbcc0111">
      <Text>Benzene &amp; Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="3cb47ce5-04d1-4ff9-97a6-da20d2b9b324">
      <Text>Let’s set things straight:</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5be3f282-be94-45ba-b508-0702bd283e39">
      <Text>BenZENE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="3cb47ce5-04d1-4ff9-97a6-da20d2b9b324">
      <Text>Boat jumping, not okay.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fe4d6548-44bd-4237-bec6-4b9d57d39c35">
      <Text>VinYL</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="3cb47ce5-04d1-4ff9-97a6-da20d2b9b324">
      <Text>You’re not on the menu on this date.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="525561d7-d0a9-4fd8-b07b-662c5da34fbc">
      <Text>BeNZENE &amp; VINYL</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="3cb47ce5-04d1-4ff9-97a6-da20d2b9b324">
      <Text>Even if you frogs are gay!</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="905980ce-bd85-47cb-93ea-4bafd7dd48f7">
      <Text>
There’re chemicals in the water turning the frogs gay/cray!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6f757208-5156-4482-b562-fd3a74f7f2eb">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="fd5662a8-9590-4dd9-b8f0-ada5428dafdf">
      <Text AdornmentStyle="-1">Friggin</Text>
      <Text>’ gay!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6c1d9bf9-8cc8-4e60-8dfb-79d3fdf1f552">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="ff6f85f4-bb93-42a6-8ba2-dfede32bd91b">
      <Text AdornmentStyle="-1">Hoppin</Text>
      <Text>’ mad!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="94a0a100-6011-431d-8d6c-0b7efdfa91a1">
      <Text>BenZENE &amp; VINYL</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="3cefc194-56e2-43c0-918c-8a415fc096d9">
      <Text>There’re chemicals in the water turning our hearts gay!
</Text>
      <Text AdornmentStyle="-1">Friggin</Text>
      <Text>’ gay!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="38ac6887-f440-4499-bdb8-581f5a899bb2">
      <Text>The boat capsizes.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="49bcfb15-45fd-4727-87a0-0adb947d784a">
      <Text>The </Text>
      <Text Style="AllCaps">frogs</Text>
      <Text> steal </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text>’s guitar.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="6ef3a79f-cdc4-4d8a-b1cd-fa62aaaa4f92">
      <Text Style="Underline">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Chemicals In the Water</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="cd9eead2-0da1-4ec1-abf8-46bf1e2c6a0f">
      <Text Style="Bold+Underline+AllCaps">Scene 4</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="8787eeae-bc52-4277-a93e-87fb06ea2e32">
      <SceneProperties Length="3 2/8" Page="12" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BENZENE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="BENZENE &amp; VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MOTHER NATURE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Bottomless Ohio</Text>
    </Paragraph>
    <Paragraph Type="Action" id="37f92682-a44c-490e-b0f4-6199a2454316">
      <Text Style="AllCaps">Benzene</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text> land.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="be45ca2b-869f-44c7-9b78-950cfd7fcc5f">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4b408be0-bb26-48f7-922d-56a2fe579a9e">
      <Text>So, you’ve never written a love song...?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="87e8f3c2-7b44-4936-b1b5-50269c6d424f">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9038cf0c-792d-482c-ba08-78685f8e5c96">
      <Text>I said... “Wouldn’t dream of it.” </Text>
      <Text Style="Italic">And are we in a dream</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e0303f8b-90d5-438b-acb2-a878534bc1ea">
      <Text Style="AllCaps">Benzene</Text>
      <Text> looks upon the frogs with the guitar in the distance.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="58205fe6-018a-4d0a-a571-b640087567fe">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="704200fe-5785-4289-96f4-40b1a06883d0">
      <Text>Seems like we are...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="06326597-149c-493f-a74e-8f28c7467be8">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="eafa9a47-60c9-4288-bf99-2d39612ede8e">
      <Text>What a nightmare...</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="65c3b024-c5f7-466c-b309-7e59db39b02b">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="8387d58d-3f00-4be3-b5d0-36dcb4fa959d">
          <Text>Benzene</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="44766c19-e687-46ed-80f9-3734928da138">
          <Text>Those gay frogs stole your guitar!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="db35c70f-32ed-4b2f-990d-18b8e76dbf54">
          <Text>Vinyl</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="4ca865a0-e853-4b19-b9f6-c118865ad348">
          <Text>Those gay frogs stole my rhythm!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="9feebc3b-c918-4a8d-9ddf-c2efc26ad92c">
      <Text>The frogs seem gay (happy).</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5afd186a-8515-431c-b98b-90937b268b64">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e889e043-c7b6-4b88-a8e4-854015e91ca6">
      <Text>Happy to make them frogs gay?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="013ac3ff-4027-4f4e-baf9-a9a05aac4a13">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="af2d58cc-61e9-4621-a12a-023c00232074">
      <Text>They’re cute. Can we adopt one?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2b3c3eae-6c55-4a78-9c9a-b716f363f8bd">
      <Text>Mother NATURE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7b8be3c3-b4a1-483a-b2ad-aa7bf71cc607">
      <Text>My children are not up for adoption, chemical runoffs!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="713d51b2-3061-492f-a075-1065be9dfb18">
      <Text Style="AllCaps">Benzene</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text> sidestep from each other like ashamed crushes.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b6d1f74c-cf6c-418b-9d16-dc2208daf630">
      <Text>BENZENE &amp; Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c2730755-7335-4572-a60e-84ec8c82cff5">
      <Text>We’re not runoffs...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d4124bad-6698-4a0c-8805-b5a02f48dc89">
      <Text>MOTHER NATURE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="51883707-453b-4704-a6ef-80017fd1eb1e">
      <Text>I’d call you two lovebirds. But, you look like you give lovebirds cancer.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e9a4d405-5a5b-4eca-b33a-f7272a5db537">
      <Text>Lovebirds get cancer and die.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="544ca1e7-0fad-4e27-95d4-81f5339a4f7d">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bd7c64eb-07fb-4ae8-bac9-7e700053a906">
      <Text>Expose yourself, invisible bird!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5ca84ed5-5836-4643-9c05-23d389b39e51">
      <Text>MOTHER NATURE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="40bf4466-ea82-49f9-a988-5e886735a167">
      <Text>You’re one too many exposures, Chemicals.
What are you doing lying around on my turf?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e73b95cc-cad4-4477-8d80-54e40f9b577a">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="33320b0a-a178-41f4-bce0-fd99d0f3d70d">
      <Text>So sorry for anyone that does.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="49ef0591-a271-4478-b136-76557a02b288">
      <Text>MOTHER NATURE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="70661501-ff5f-4578-8f36-d23e6166d898">
      <Text>Oh, you’ll be sorry-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9abc631f-85e2-4d99-b3a5-34d19d359f3c">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="662785a9-701c-475b-8099-eff104875bb2">
      <Text>What Vinyl meant to say is that we hate Ohio!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="11f140f4-ba00-4a6f-96c5-53930f5943fa">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="320eaffe-ce73-44e5-aba7-0f4cb4484e40">
      <Text>It’s only natural that you hate it, too.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c24ad9e2-457e-4768-9d85-346130bc1648">
      <Text>MOTHER NATURE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="298d5fc6-bc7b-41ab-b759-ea9f64312f9b">
      <Text>Mother Natures loves all her children, even Ohio... sometimes. Now, are you here to harm my children?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9e734678-ec34-456f-a87b-fcb37875e6a2">
      <Text>Benzene &amp; Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="90050cf2-82b6-4076-bac5-57ec34f61970">
      <Text>We come in peace.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="43a0f6d2-2f32-4f51-96ff-e70c79ece2f2">
      <Text>MOTHER NATURE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f39babc2-cb2f-493f-bc33-cf79e7c445d0">
      <Text>Explain the rivers of dead children behind you.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="798f22f2-7ac8-4aed-a98d-c4c973997cc9">
      <Text>A stream of dead fishes is behind.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="750a21cd-9e73-4c2e-a778-93f310fa4963">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8a2bf550-b2df-4705-b98e-5a5aee9b9b65">
      <Text>Living fishes are just as alive as dead ones...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="631113eb-909d-46fb-ae2c-d885194bd99b">
      <Text>MOTHER NATURE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a32ed325-9b44-4ec8-9e35-40612c9c0071">
      <Text>I have Chemicals to fry.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c72f71bd-e06a-4b7a-9dc7-3627b69dc36f">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c677fad9-8f1b-4459-ae73-8261293dc64d">
      <Text>I don’t wanna die...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="53020081-8a25-4903-b53a-eafaa7470b88">
      <Text>MOTHER NATURE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="eae9d937-0e2a-42c9-8a83-5888b1607c77">
      <Text>You performed a sin to my children, far worse than death. You turned them </Text>
      <Text Style="Bold+AllCaps">gay</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7ca96cbd-da16-4eec-badd-db79a1ea7b8f">
      <Text>Benzene &amp; Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="2317b0a9-ba98-41b8-8114-42d5dfd62df1">
      <Text AdornmentStyle="-1" Style="Italic+AllCaps">Friggin</Text>
      <Text>’</Text>
      <Text Style="Italic+AllCaps"> gay</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b605f8dc-7069-4a2d-abd1-5f3b6b377f5d">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1798c944-9267-4bc5-a018-2b095543550c">
      <Text>Mother Nature, </Text>
      <Text Style="Italic">that’s bigoted of you to say</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5a581bcc-c7e9-41d8-ac10-72bb925394ca">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d5f1c800-d0ef-41c8-9672-536512ea62a2">
      <Text>Mother Nature? More like...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cf238348-dbea-41eb-bf27-6de03be1a141">
      <Text>Benzene &amp; Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8c2e14c2-e0cb-4614-8cd2-7f59961a28f5">
      <Text>Boomer Nature.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f5605bd8-958a-4538-8eb2-b72dc03b0623">
      <Text>Mother NATURE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="32c72e34-95ef-45c3-abfa-71f2828f6faa">
      <Text>Bigoted?! Begone! You’re speaking to Earth’s most fabulous diva. I don’t need other forces of nature to one up me. What are you two up to?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="501ce39e-1bec-4463-b7dc-c64ff52b4036">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8c782bb6-c15d-4e45-9d12-b15649a72d2f">
      <Text>Nothing toxic.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f3376874-d6c2-4f85-957c-2882ba19b28e">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c9ab81a9-dd75-42ae-992e-2131b0414570">
      <Text>We got off on the wrong track.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f8fb7ddb-694f-4573-b2f8-3765d6a07978">
      <Text>MOTHER NATURE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cf0b723b-7d1f-446b-85d1-b53681b4c978">
      <Text>When was the </Text>
      <Text Color="#00000000FEFE">Chemical Revolution</Text>
      <Text> ever on the right track? Since the days of </Text>
      <Text Color="#00000000FEFE">Faraday</Text>
      <Text>, your kind have been what’s wrong with the world.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ff6ede11-b322-4c48-8a1e-73099eabd856">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5666e1a3-b802-432c-9a96-c3792d39da22">
      <Text>That can’t be. We’re cancers!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9f95eecf-4231-49d2-9e51-0237e5f2b63d">
      <Text>MOTHER NATURE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="55833058-6ad7-49a1-b360-9a0465b9152e">
      <Text>Chemicals are literal cancers to planet Earth.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fdfe753d-5aa7-43ac-8c8d-9c29e8eba822">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2d9f7c2a-733b-4aba-bedb-8b01d4d3d7b5">
      <Text>You’re right. We’re nurturing and intrusive.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a1496643-47d6-4577-ad08-bd5928fb6bf7">
      <Text>MOTHER NATURE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="37a001e9-d476-4ffb-9d2c-5438c2854d2b">
      <Text>Invasive. Yeah, nurturing to the capital.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="05743607-7513-450d-91f8-d15b8d55648c">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d3a0c16e-9aa7-444b-97f1-003684b25fdd">
      <Text>Look, nature. I don’t entirely believe in this astrology nonsense.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="36ccaf73-0825-4a1d-a854-9e47888e38b0">
      <Text>MOTHER NATURE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b279ccab-ac0c-4c5c-a585-357a2cefb408">
      <Text>I’ve lost my sense of smell from y’all. I’m losing my sense of time.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6b762533-3d47-4683-beda-7c0e758dde5e">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="50f78cdb-beb7-4c98-bd1b-d4405812cc19">
      <Text Style="Italic">You know time</Text>
      <Text>’</Text>
      <Text Style="Italic">s signature</Text>
      <Text>, </Text>
      <Text Style="Italic">Vinyl</Text>
      <Text>. </Text>
      <Text Style="Italic">Tell Mother Nature</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d0656cfd-6343-412c-b010-698c839c60d7">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="885cf1ed-f7d8-4e4e-aaba-a4b0b45bd4dc">
      <Text>Four </Text>
      <Text AdornmentStyle="-1">four</Text>
      <Text>. Three four. Common time. Cut time. Seven eight. Twelve eight. Several of them from Tool's </Text>
      <Text Style="Italic">7empest</Text>
      <Text>. Six and a half eight in </Text>
      <Text Style="Italic">Schism</Text>
      <Text>-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f3565f99-1134-4576-a354-17d856ed3513">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5aebd2e4-35dc-48fe-82d6-737aba519b5b">
      <Text>Not those time- Whatever they are. What time is-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="997a763b-da36-4e5c-b691-5766ac243f18">
      <Text>Mother NATURE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="81aee7b8-1dad-4358-9839-a88a7cc7b213">
      <Text>It’s time to get on home.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="d567005d-25e4-4e59-809b-713d1e63363e">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="c643e5c2-c56e-4307-826d-a63f182ff8da">
          <Text>Benzene</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="fd5e71a7-d54f-487d-9321-1b34fa95778b">
          <Text>I’m not trying to head back to Michigan.</Text>
        </Paragraph>
        <Paragraph Type="Character" id="241f8c3e-4a95-4bc9-92a0-bd140b2442f7">
          <Text>Vinyl</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="f5fddf54-b63d-44ea-98e6-369207922e7c">
          <Text>We’re trying to...</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="4c47451a-9752-4c12-926d-020ae7a886b4">
      <Text>Mother Nature (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="92e5fb31-c580-44b7-a495-765654c5d52a">
      <Text>Follow the manmade trails that another cancerous species paved on me.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d195731d-8ac7-49d5-9658-329a814edf8f">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="61b3678b-53cc-4f96-af06-59236f661a64">
      <Text>Oh man...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d73e37aa-6a94-4e5f-b955-436e671ed87c">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bde94a66-f1c1-434d-bc70-813d436e4f7a">
      <Text>Ohioans made this. Follow my lead again.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4ef4b1a4-9fdd-4a9c-ad92-bfdcb04da359">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ee972bd6-2e0b-4235-8fc1-fa7e4a03ffa9">
      <Text>See you later, Mother Nature.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="05027b5f-a6ca-4771-a100-3e0297faa64f">
      <Text>Mother Nature (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="09a27386-1a2f-430c-9a37-f1a8cb036b55">
      <Text>I’m everywhere. I see everywhere. I’ll feel anywhere, capiche?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d5b36d18-eedb-4f49-952e-f98fb816a83e">
      <Text>BenZENE &amp; VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b912349a-777f-4b3a-8f4c-5674fb917456">
      <Text>I feel you.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b69882cd-199b-4a69-8b18-1caf81aa49e1">
      <Text Style="AllCaps">Benzene</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text> walk the trails.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="60ee447d-c830-43d9-b3ac-5762e51ef7ba">
      <Text Style="Bold+Underline+AllCaps">Scene 5</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="10cac20f-cb0a-42da-8e98-e19dd31cf234">
      <SceneProperties Length="1/8" Page="15" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Manmade Trails</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="1d92faf7-c8a6-44cf-a951-5a7622b61afd">
      <SceneProperties Length="4/8" Page="15" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BENZENE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PARSLEY &amp; PYRUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Optional</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0040ee2d-0af8-4a31-9648-31aa0dd8475a">
      <Text>A parsley and pear plant are present with a recording of “</Text>
      <Text Color="#00000000FDFD">Photosynthesis</Text>
      <Text>” from David Quang Pham’s plant-based musical </Text>
      <Text Style="Italic">Turnover: A New Leaf</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8127149e-663e-4402-9b3c-2195d33d6e17">
      <Text>Parsley &amp; Pyrus (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bc882f33-617d-43b4-9478-495310373840">
      <Text Style="AllCaps">Photosynthesis! Photosynthesis!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2bb46e37-9ab0-4b32-b0db-31253855f090">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="caea3be9-67af-4f0e-9cf9-6e9daf7726f5">
      <Text>You hear that?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ee9474a0-906d-433e-8aee-e70ab2fc15b8">
      <Text>BenZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6afae879-1441-4e1d-86a7-2a53af85fd9a">
      <Text>Aww... Parsley and Pyrus are photosynthesizing.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="22f59fb4-a3e9-4bba-be0e-7e501266e276">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> crushes or kicks away the parsley and pear.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7b46414f-c965-46e6-8313-19616557a899">
      <Text>ParslEY &amp; PYRUS (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="da64a51f-b69d-48d9-981a-599aacb39b33">
      <Text>(Tormented)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9b32e0f2-aded-4e6b-b4ac-210795ce66cd">
      <Text Style="AllCaps">Photo- </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Ahhhhhh</Text>
      <Text Style="AllCaps">!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7825931c-6aba-441b-b784-45bef8abbd8c">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a86642fe-264d-4b56-a27c-66cd0ddc25ac">
      <Text>Mother Nature’s plant children did nothing!</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="339fb47c-3aa9-4617-8738-8d813db42103">
      <SceneProperties Length="1 1/8" Page="16" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BENZENE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">End of Option</Text>
    </Paragraph>
    <Paragraph Type="Character" id="dd70e9d4-69f5-4d1f-84e3-25611f199161">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ff1391e1-0532-4d19-913e-140849105c29">
      <Text>Mother Nature has no right to say what our founding Chemicals fought for in the Chemical Revolution was wrong.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7ee7dfcb-b8dc-46fe-9166-7fadf9b82441">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a14f5732-df1c-42e5-8727-79dc589b39d0">
      <Text>Were we wrong?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5b99debb-71f7-4790-bd14-47f0b3fcf264">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9f624ffe-68de-484f-a4fe-41266b782e84">
      <Text>For them to gain reactive radical independence for their valence?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="38660eb7-2b27-489f-ae2d-5e3f4f463166">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f12e7abe-0f6d-4b06-91fe-9016793c89d6">
      <Text>They made compounds where they shouldn’t be.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="af433a76-82cd-4f6a-a607-1c15a7a38577">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5dc6a368-95df-44ae-a75e-d5e48946c581">
      <Text>They belonged here.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="139505ca-490c-43b3-808f-014a7222667c">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="48785c6a-8551-41d3-af89-199be8f8fccc">
      <Text>The Chemicals drove out the Naturals.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9c982f14-41af-4c0f-ab29-40ecfe26246a">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="68e64fda-6c23-47c6-ab5e-f7b28e77a17e">
      <Text Style="Italic">Beat out</Text>
      <Text>. </Text>
      <Text Style="Italic">The Chemicals beat out the Naturals</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b43b446f-2edb-4d04-b133-a48f9f550e44">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d344b8fb-54b1-4f6c-810e-d85473fa8580">
      <Text>They shouldn’t beat them.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ea71c054-c3d5-4295-a07e-0d7fc4d61f39">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b99a0dc9-6b2f-44e8-ba62-2c81bff67dd1">
      <Text>Then, they should’ve joined them?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c7cb6747-3612-4738-bdc4-9d46580375b1">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="52ae0353-9bcb-40fa-ac74-d3e56def9098">
      <Text>We should’ve joined them.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1a5c0842-f6ca-4e83-a89d-d5701d0ab6f5">
      <Text>A </Text>
      <Text Style="AllCaps">fox</Text>
      <Text> enters.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="550b1725-9d8e-49f9-afee-10954def0265">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="79984086-5edd-45c5-bbfe-3a7643cb51f0">
      <Text>Joined them in the fox holes.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7bfc8a01-d09b-4ce2-ae0c-f08c026858c5">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> distances away from the </Text>
      <Text Style="AllCaps">fox</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="32867638-aae9-4c03-a9e2-2f0e76fbb1b8">
      <Text Style="AllCaps">Benzene</Text>
      <Text> approaches the </Text>
      <Text Style="AllCaps">fox</Text>
      <Text> in awe.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4700e2cb-4f62-49dd-9ded-afaed835cc5d">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e2b3bb6d-055b-48e0-bdb0-0de1b335eec3">
      <Text>Aww... What’s your sign?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1e8b020f-0c18-46bb-9199-c3599a60ccfa">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b6144359-05e8-418f-86a6-b8ac04f27b24">
      <Text AdornmentStyle="-1">RABV</Text>
      <Text>-G.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="75538517-3520-4a97-9431-1af1e730941b">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="24c9dab9-3eb7-4414-9f9e-86be5329d789">
      <Text>Gee. Judgmental much? They don’t have rabies!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="07e444ac-0a76-4041-afe5-2cef7a0acc3e">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d689f630-290d-431a-8c3e-1de26a336253">
      <Text>Then, join them in </Text>
      <Text Style="Italic">death</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a010e130-ce10-428f-8d40-9256804a9ccb">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="77c86f37-4e30-42f6-9b52-3f27aa8dfee3">
      <Text>(to the fox)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2e54d803-094b-4d13-883d-a324ff4236b0">
      <Text>Fella. Your silence will not fall on deaf ears. I am here-</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="b2ea6f3a-4923-487f-88c3-cfeb09628b18">
      <SceneProperties Length="2" Page="17" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BENZENE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="BENZENE &amp; VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MOTHER NATURE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline+AllCaps">5. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Kick Mother Nature In</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2c3bfd5f-2c38-450d-9b0b-d42d7049a2b7">
      <Text>The </Text>
      <Text Style="AllCaps">fox</Text>
      <Text> attacks </Text>
      <Text Style="AllCaps">Benzene</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="706a31b7-6b6b-4752-ae4e-5298a943a179">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="460fef77-b802-4fa5-8582-b962260a12af">
      <Text>Get them off me! Ah! My atomic structure!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ea0b29ee-1025-4e12-9392-3979a1d7db5a">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c035d157-7ac1-48af-b2e7-7a0c98ddaee2">
      <Text>Hold still!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6b293afb-e52d-40c0-8133-c1daaec5a281">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fd5941de-56f4-40e7-b8d3-d8de77c926be">
      <Text>They’re going for my p-orbital!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="68c974cd-5096-4b8f-b673-dcb9cce71969">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f9c7edfc-a6b8-408e-a9de-8866f2a7c3fb">
      <Text>Anywhere but there! That’s where you p-bond!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8ecdcf34-6591-4ead-9268-02cd5f3db1df">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> whacks the </Text>
      <Text Style="AllCaps">fox</Text>
      <Text> off with a </Text>
      <Text AdornmentStyle="-1">PVC</Text>
      <Text> pipe, killing them.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d1b5a952-f7f6-470d-b827-82c3e7d1406e">
      <Text>Mother Nature (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="79e12895-765e-4eef-a727-10a520d422cc">
      <Text>These manmade trails are not made for mankind, but my children. My guardians... defend your mother!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e512acbb-87ec-430d-9777-937b3d6fc215">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> wields a second </Text>
      <Text AdornmentStyle="-1">PVC</Text>
      <Text> pipe. They guard </Text>
      <Text Style="AllCaps">Benzene</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a9e4eaac-e5e9-4de6-b284-af479359cc2b">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2980aaa1-e72a-4bb6-93b8-cdc22ccfc63c">
      <Text>Reminds me of mosh pits.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8d7faadb-fd2e-42f2-8321-362f66965274">
      <Text>Trickles of </Text>
      <Text Style="AllCaps">foxes</Text>
      <Text> attack </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text>. But, </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text> bats the </Text>
      <Text Style="AllCaps">foxes</Text>
      <Text> away with ease.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="47daeff8-c56e-49db-acbd-1d5571d37669">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="68639c08-0141-4b57-a0c8-48599d502a37">
      <Text>I’m gonna leave a chemtrail of death!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="2b9c698c-4410-434c-bff7-a88f1f2914c5">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="bf112237-a62a-4a28-b8e5-3265e661e8a5">
          <Text>Benzene</Text>
        </Paragraph>
        <Paragraph Type="Parenthetical" id="82c8229d-24ee-48f2-8b88-160d394d480a">
          <Text>(Repeating)</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="bc016d34-95e9-4052-b739-c464e32f7dd3">
          <Text>Mother Nature...</Text>
        </Paragraph>
        <Paragraph Type="Character" id="f67778ed-79f7-40d3-9f33-afc2911a210d">
          <Text>Vinyl</Text>
        </Paragraph>
        <Paragraph Type="Parenthetical" id="9d58d712-14ee-4292-adb3-25cff8542ad9">
          <Text>(Repeating)</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="0373ebf2-315e-4804-a03a-2b225424dbfb">
          <Text>I’ll fuck you up!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="292c4c5f-aba0-41e2-87bc-b7475ba4b46b">
      <Text>The </Text>
      <Text Style="AllCaps">foxes</Text>
      <Text> stops attacking.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2d3186e6-02d7-4e3d-8bbe-5ac9885e75e6">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d6dbf936-dc82-4ad7-bd0f-30bcd6741a82">
      <Text>Anything </Text>
      <Text Style="Italic">new</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d927ccfc-dff1-4d26-8373-c05dcf271279">
      <Text>MOther Nature (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="29ba8fd9-f597-41d4-b125-966c94c4a55b">
      <Text>Deploy all land troops!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0da81197-8c0c-4c7f-b129-b25767be3623">
      <Text>The atmosphere turns as orange as the </Text>
      <Text Style="AllCaps">foxes</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="76ad7246-9b89-406e-ae49-f7935a5de6b8">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> swipes about. They get overrun.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="81013cfc-419c-41d5-87a6-7d3fd227f4e3">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c2a2c41f-0a3c-4a1f-b708-b046f743db58">
      <Text>There are too many! They’re on us!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="eb4bf7ad-ac2d-42de-808d-cc29faaff087">
      <Text Style="AllCaps">Benzene</Text>
      <Text> takes a </Text>
      <Text AdornmentStyle="-1">PVC</Text>
      <Text> pipe and fights alongside </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="16ffebe3-d782-4cf1-af7d-920edcbc4f32">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="ad0097ac-7380-4784-bfa5-e592cc18cf76">
          <Text>Benzene &amp; Vinyl</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="d40b528d-bd1f-41ff-8880-4fec4fa95a77">
          <Text>Ionic bond!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="72f8adfd-1454-47ae-9654-dd14eef803d1">
          <Text>Mother NATURE (V.O.)</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="28bc797c-ae3e-4b6c-bfce-8f04dc4c6ac4">
          <Text>Ironic response!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="9aefb9b6-54de-4c23-bd3f-ca7bc0ab20c2">
      <Text>The atmosphere phases from orange to blood orange.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="32c994eb-d2cf-4a68-8624-b6fd10c9970d">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="29b49d06-da04-459f-8ce6-aaea3fe840f4">
          <Text>Benzene</Text>
        </Paragraph>
        <Paragraph Type="Parenthetical" id="4fb59afd-722f-45f1-ab40-cadd33471c01">
          <Text>(Repeating)</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="5c8134c8-2a46-4479-b4f9-0c5137242789">
          <Text>Mother nature...</Text>
        </Paragraph>
        <Paragraph Type="Character" id="cfd726f3-c717-4b96-872f-aaf7589afb7a">
          <Text>Vinyl</Text>
        </Paragraph>
        <Paragraph Type="Parenthetical" id="f3112bdf-5c99-4d96-9552-c47610c415b9">
          <Text>(Repeating)</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="43518bc8-bc83-4930-8ba1-71bc92e6c4ac">
          <Text>We’ll fuck you up!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="482f5eea-45fb-4200-b192-a148033a61c0">
      <Text>Mother Nature (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2cabbfd6-d029-4ff8-96e9-4d9923aa8b9a">
      <Text>You sank my navy. Stomped my army. But, you cannot bring down my air force!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9ab8836a-930f-43f8-bf52-7587b7fdabd1">
      <Text>An </Text>
      <Text Style="AllCaps">eagle</Text>
      <Text> soars by.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0c5ef307-a3dd-4234-9d05-4629b7be90ed">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> hugs </Text>
      <Text Style="AllCaps">Benzene</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="903f979f-fc15-4a0b-8553-647316c0bb70">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="46efaab9-94e6-44c3-9e96-4e302629325d">
          <Text>Benzene</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="4187da5f-a54f-4be5-ab5b-4efc60e723ee">
          <Text>We ain’t that kind of bond!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="564df937-b28a-4a67-92e2-cbd65417c6f5">
          <Text>Vinyl</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="221ccaf4-d057-454a-b7f3-1f11f4dddfaa">
          <Text>We ain’t that kind of Chemicals!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="afe2238c-01f9-4437-b0bb-4281bad71616">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="48ce90c9-9047-4e75-be0b-dee024a2ec69">
      <Text>Wait, what...?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ce4de988-a4f3-4fff-8a07-deeda9b203b2">
      <Text>The </Text>
      <Text Style="AllCaps">eagle</Text>
      <Text> cries.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="139f7818-ce57-4424-87c5-d5ba5cbb1057">
      <Text>Benzene &amp; Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="21daa985-7c97-4a4f-a85b-56cee7338444">
      <Text>We’re not airborne chemicals! Ah!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="41a69ae0-3086-4adf-8509-eee66aca3eaf">
      <Text Style="AllCaps">Benzene</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text> run about. They come across a town.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a8981b68-d5fd-4735-bb52-317a6cf9d893">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e4001ee6-e4de-4c89-b313-7fdee6174ca8">
      <Text>Look! A town!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ddf52e13-15b8-4716-b1cf-f9d007521bf4">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="d7e187bf-cb3a-4c20-90a4-9e3badb7dcde">
      <Text>(Reading)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1784c12a-25de-400b-8242-160210868f3e">
      <Text>Cal... Calcutta? Ugh.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8c5a0b34-d5b5-4296-b036-53d02d888b23">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fdf3deec-2c62-41fe-b782-bfd1c3c075ed">
      <Text>Calcutta, California, Calgary, Caledonia, whatever! Run to safe toxicity!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="26b64510-846c-4713-95be-7003c12287d6">
      <Text>The </Text>
      <Text Style="AllCaps">eagle</Text>
      <Text> cries.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2803630e-ba73-4525-adad-c3c24ab35111">
      <Text Style="AllCaps">Benzene</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text> run to the town.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="09f0984b-8624-4a40-8211-ede755ede319">
      <Text Style="Underline">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Kick Mother Nature In</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="e1d61baa-5619-408c-b163-dcf9bde291c2">
      <Text Style="Bold+Underline+AllCaps">Scene 6</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="5f25af0f-484f-49c3-8cd7-d36dc5aa008b">
      <SceneProperties Length="2 6/8" Page="19" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BENZENE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Calcutta</Text>
    </Paragraph>
    <Paragraph Type="Action" id="fd549e3f-69d4-4eb4-bf6c-f574f6522a17">
      <Text Style="AllCaps">Benzene</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text> catch their breath.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="022f9b86-29c3-440f-87b5-e70c91489b5c">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="71b7bd10-0cc6-477e-a8d2-e0b33ea82141">
      <Text>Away you go, winged monster!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="57f642bb-b894-4dd5-9c31-d70a8b69b804">
      <Text>BenzeNE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="60042015-3fa7-4086-add3-57a53936596b">
      <Text>If only we’re as up in the air...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="71f38979-39ea-4f47-9bc0-77932f6eef2f">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="69c99a26-f131-4963-a481-1a7257909912">
      <Text>I’d rather not go airborne. It was either riding the train or setting foot on the soil.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="aacf5770-7677-4c1e-a804-c4234d7b9a33">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="00c0c050-2b02-42fc-9ceb-045e7be8a76c">
      <Text>Or settling fights. Thanks for letting me play with your pipe... You should wash the blood off these.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ff6bc81b-8ae3-4622-992b-bdd48067941b">
      <Text Style="AllCaps">Benzene</Text>
      <Text> returns the </Text>
      <Text AdornmentStyle="-1">PVC</Text>
      <Text> to </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8b61acd5-d068-435f-a2bc-1131da3f4028">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4c525ced-4df5-4a83-9887-96fde6b788a4">
      <Text>Bloody Hell.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9fbf8ea2-916e-4055-be85-8fabfc97949b">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="14ca4609-3084-47a6-8be9-338b6195a47a">
      <Text>Hell’s in Michigan. Where are we?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b2c7605c-954d-4683-b573-799c0af65049">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b1ade1ea-51e2-4c2c-9614-fc6664eacd9a">
      <Text>Calcutta, Ohio. Not the Kolkata, India my cousin studied abroad in. They ate amazing food with eight </Text>
      <Text AdornmentStyle="-1">pH.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f37e44af-e3b4-4bad-a037-3c5d416ebd2b">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="37fba1d7-124c-4088-a4e3-e2a20c61c69d">
      <Text>Let’s put Kolkata as our next crash landing destination.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3090709b-0749-457a-a532-2b2b80e257a9">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="54a53a61-6f98-4442-8129-93ad331948bb">
      <Text>We wouldn’t be stewing in Calcutta, Ohio if you hadn’t poisoned the conductor.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c594d34e-b87a-4c31-883f-bcde87659668">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="29e385f3-6e87-41fe-8062-62735d3cda50">
      <Text>I did no such thing.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fbd4faec-0b63-4993-8915-5bb896cf430a">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="945ca824-3663-4093-a789-106b82b69fe3">
      <Text>It’s Hell.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a216ac1b-a655-421f-9db2-411c30e72910">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c75a856d-f62e-4249-8ba3-5e0f21e95172">
      <Text>You made everything a living Hell!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d33cc73b-add7-43d0-9112-599dddc86da1">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="004efd8a-10c8-4fca-82c9-857da010ac29">
      <Text>(Positively)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c901ef48-ac06-4edf-a177-0757f54a9eaf">
      <Text>Yes. It’s hot. What you did to get us here.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3e24d0f5-b2e2-454c-ab87-c90ea204432d">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="d939e231-03a7-4d09-a996-abd85b6ae676">
      <Text>(Unamused)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c4711b96-ca86-497b-8eb5-c53681f07b5e">
      <Text>I get it. We’re flammable.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6fb046cd-1892-42dc-b39d-4d16bae79b39">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ed4014af-32c3-4aaa-9af0-16546c3b6946">
      <Text>We’ve reached a boiling point.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0f18a17e-2dee-4e56-a1fd-2c814c742e46">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4e58da52-acca-42b4-845b-8097dd7f81a7">
      <Text>No, we haven’t!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="46b8545b-bc9c-431a-a845-961c411ea765">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c493d31d-19b8-444c-82aa-82e1c131e05d">
      <Text>Why are we arguing?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6bbe3722-0823-4d1a-b913-43ccf9f71505">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f15547a9-8535-412b-a3f3-33c3c6f61136">
      <Text>Why were </Text>
      <Text Style="AllCaps">you</Text>
      <Text> arguing?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="be33ee41-f99f-4483-961b-8a7081d9b02c">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c94f8bf6-6ff0-41cf-8155-01fbbc5ada6c">
      <Text>I can’t help being toxic!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c0316b7b-8fdb-4f79-a4cc-22021b98557b">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6ccef5be-84c4-4c2e-a280-29555f6f58fd">
      <Text>Color me surprised.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4a440f77-0692-41de-a210-7be0d77d6d10">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0e75adf9-1005-4a4c-97fa-6ec4fce2651f">
      <Text>You’re colorless, Benzene.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ab7ccd2c-bf7d-48dd-b93e-6711ede72fc9">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8bd5c71f-3460-4c2c-a0e8-433bfa742d73">
      <Text>Speak for yourself, Vinyl Chloride.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d0810bdd-bbc2-4eea-9453-8326189ec4b2">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3f488106-e5df-4fe9-8919-e5c11eca0fed">
      <Text>I never spoke for myself like I do now. And it’s because of you, Benzene. And we’ve been doing a lot of panicking, running, fucking up Boomer Nature, and arguing... I speak my gay heart when I say: </Text>
      <Text Style="Bold">I want to share electrons with you</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f15030c1-15d1-4c37-87f7-1bda233c1c32">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="32661571-889b-4c2f-a4b3-102d26d36a91">
      <Text>Negative?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3b7f0a93-bc41-4a8c-866c-4a8740cf0e25">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a04ddb12-f21e-4fab-a0ba-f22a0423aae4">
      <Text>My electrons are for you.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f38d51e7-e9ca-4070-8b8d-c00a813859d3">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e7d41a90-5fd4-47cc-8989-7750aff6aa04">
      <Text>How do you expect me to let my rings localize?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bbe6cf86-3904-4813-b582-2315732758b2">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6b081b7d-fb72-4952-bc84-b42bf79a16b1">
      <Text>How about you and I pi bond?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a4474c16-671c-4f86-8e3e-4839ca1808e6">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4cb9db83-56a8-4edd-a89c-ca2723e30bfa">
      <Text>How about you pi off?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="68ace202-09ad-4062-84aa-ab60ab291a6f">
      <Text Style="AllCaps">Benzene</Text>
      <Text> is about to leave.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bf0436da-9b06-431e-a6ed-9ae21aa61ff6">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1909e379-100b-4971-8f0b-0a62f46e6fe7">
      <Text>Benzene. Don’t my valence electrons mean anything to you?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9db1d612-0822-457e-8e5b-cc8f4458ab83">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0671ab35-863d-4441-854e-bfd96b6dce9e">
      <Text>I’m sorry, Vinyl, I know your pi bond are localized and mine are not but you cannot show up in my orbital and share electrons and expect our chemistry to work out. Chemicals don’t synthesize that way.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3924f614-ac51-413f-bf41-1d451a3b0f2d">
      <Text>ViNYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c5702d75-0502-4003-ba95-587c2274089f">
      <Text>What are the chemical properties needed?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="45b290c0-2634-4af6-8ba6-30d654c85b1c">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e4e70800-6052-4e8f-881a-6fac986af488">
      <Text>I know my hydrocarbon self ain’t your property!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9c99deef-6f76-48d2-b9f2-6d802f18f92b">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3dbfd28c-5220-44cd-8fff-ced2ce01c959">
      <Text>I love your properties. I love that your boiling point is 80 degrees Celsius. </Text>
    </Paragraph>
    <Paragraph Type="Character" id="896a0c6e-0ca3-4407-b78f-88abbf0bb34b">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d8719a4d-f7f1-4154-85ac-1824d85c6629">
      <Text>Don’t make me blush at 42 degrees Fahrenheit melting point.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3eff0a9d-f813-4f78-8b1f-a1d3f26d0034">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="697e37ad-bf9d-4263-85ab-416ab005cc1c">
      <Text>I love that you’re somewhat dense. 876 kilograms per cubic meter dense. I love when you make nylon faces whenever you play with my pipe. I love smelling your aromatic perfume. I love dreaming about the gay frogs we’ll adopt. And, I love that you’re organic. And it’s not because I’ll evaporate quickly knowing you’re actually insoluble in water... We didn’t just fall in the river, I fell in love. I am toxic with you because when you realize you want to contaminate the water supply with someone for the rest of your life you want to start the acid trip to toxicity as soon as possible.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="01212b39-ea12-42cb-8a06-29303f7713fc">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="c41dd5e3-2837-44fd-a8bd-1e5704d88d5c">
      <Text>(Conflicted and teary-eyed)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="06cfa624-29c8-45c4-b85a-59cec5bcf52c">
      <Text>You see, that is just like you, Vinyl Chloride. You spill toxic waste on me, making it impossible for me to not pi bond with you. I will never ever share electrons with you!</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="b613d956-3f7e-449e-97a4-cc96eb0e38a5">
      <SceneProperties Length="2 4/8" Page="22" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BENZENE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="BENZENE &amp; VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline+AllCaps">6. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">A Toxic Relationship</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="25417a89-2254-471e-8195-39cca6774f40">
      <Text>BenZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6bec79ce-7da4-4e01-9cf3-4702eaf62405">
      <Text>You’re toxic...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="47ef6d8e-d7ee-4812-9ea8-85e8dfb0f217">
      <Text Style="AllCaps">Benzene</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text> look into one another with profound tension, bordering kissing or killing. They suddenly get in tango with chemistry. They dance in a garden that soon whither. They dance by buildings, where silhouettes of couples occupy. Healthy love is in the air for the </Text>
      <Text Style="AllCaps">chemicals</Text>
      <Text>, but they are spreading toxins into the air of mankind.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="69bb1449-b219-45ef-830a-48fdf089822d">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="13fd802e-f1c0-49e0-86fb-717d35af7004">
          <Text>Benzene</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="f88ea124-f350-4e71-902e-44cfecd161fe">
          <Text>Cortisol...</Text>
        </Paragraph>
        <Paragraph Type="Character" id="b27ec118-a4a9-41cc-b71e-f0f591ad2e78">
          <Text>Vinyl</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="6a1b97c0-4dbc-4988-96ee-0750ea7626b0">
          <Text>Dopamine!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="9c4886e5-4d84-414a-b671-9b0c09a7c614">
      <Text Style="AllCaps">Benzene</Text>
      <Text> grows bored of this dance. </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text> takes notice and switches up to </Text>
      <Text Style="Bold">Apache</Text>
      <Text>. This demonstrates toxicity. They ferociously dance, unphased at the silhouettes of couples growing unstable and arguing inside the buildings, representing toxic relationships.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="363b4f7e-59da-45b7-822f-e28c5567efe7">
      <Text>Benzene &amp; VINYL</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="7fae8811-b42f-4d71-9423-d1b82a270d74">
      <Text>Oxytocin... </Text>
      <Text Color="#00000000FEFE">Aromatic Stabilization</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c7c747d4-1d96-4fe2-90fb-a1a2802e2107">
      <Text Style="AllCaps">Benzene</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text> experience intimacy via chemistry by getting into each other’s atomic orbitals and sharing valence electrons.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6a7166c6-bbd8-4e92-a2d5-698808dff043">
      <Text>BenZENE &amp; VINYL</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="d808b52b-3d57-4a2d-b493-f8fb4ba75b0b">
      <Text>(Cheers to each other)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2600f71d-ee31-4ffb-9b65-6ade018a92ca">
      <Text Style="AllCaps">To our toxic relationship!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6ac18102-710d-40f5-902e-f8b8bf898559">
      <Text>Everyone on the production team coughs with their masks on.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="b6cec695-8dbf-4ccc-b9ca-ea7c2506e2c9">
      <Text Style="Underline">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">A Toxic Relationship</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a425807e-4288-407a-a77c-032a48716d99">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9208fcdc-577a-4267-b5b6-509116900c27">
      <Text>I don’t believe in astrology... But believe me that your body and your soul... Your atomic structure is a constellation.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a425807e-4288-407a-a77c-032a48716d99">
      <Text>Benzene &amp; Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0166a6e3-47cd-4c24-a8df-e7c3a7acb6ac">
      <Text>There’re signs of life...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="39b0bcfd-2a73-46fc-b198-e270afbaf26e">
      <Text>The atmosphere phases into signs of mankind.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e22f14fa-1f10-4162-ad20-f92a2b5b4f3e">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="57e4f291-526a-4426-a23c-66929714cede">
      <Text>We’re bringing out the ghosts in this town.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="49083737-fe89-4c11-a563-46dcdc21f8f0">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b8e78b55-1d94-4087-a313-d18effe1504a">
      <Text>Holy nuclear winter, there are people here!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f5efcc17-4b1b-4aba-b160-a964a2c15d42">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="18d382dd-2c29-4f06-bc41-66717685a0b5">
      <Text>Calcutta has some strange-looking people.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e810eaae-9bcb-457d-a2df-d9ffe3586316">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="65fb363b-e471-4e48-854c-cd73f4b4e6ad">
      <Text>Well, they don’t look too healthy...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="461cfb23-816d-4813-b9e2-366931f9ef50">
      <Text>Audible sounds of the mob echo.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="494d612f-05f3-4ee7-8bc8-96115d10009f">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d3301ebb-24f7-473f-bf73-b88dc76ca0ce">
      <Text>They don’t sound too happy either. It’s the most toxic thing of them all.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0e6bbf25-b711-40d8-b17e-1c00800f390c">
      <Text>BENZENE &amp; Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="aa7fd983-4130-4764-92c3-8178868129f0">
      <Text>Mankind.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d58f38cb-49e2-4958-b85b-aa97148e5653">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9f8b7aae-f626-43c1-9582-b81fea8b37ee">
      <Text>They also know all. You’re sweet. Tell them that we’re lost.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="35d31cc5-e6be-4663-9780-58740e8c9fcb">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="a2a76888-f7e7-40e2-b417-f737404dea4d">
      <Text>(to the unseen mankind)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="226a9b77-3119-46c0-81c7-6b90e4055667">
      <Text>Excuse us, where is the exit?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="cf946102-0ee3-4177-9378-c9d88609ae54">
      <Text>The mob mumbles their answers.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="040540b0-d91c-4687-b5ae-2861a9f496d0">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0176ae12-e43f-41d9-b1fe-fcd9cbf27409">
      <Text Style="Italic">Oh out of the state is more than fine</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3d4943ba-c467-4b40-8c32-04efe9bb7517">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="59b3b7dc-c135-4fac-ad25-56caf3f96234">
      <Text>You’ve been wearing masks for years now, so another is not going to hurt. Okay, okay. We’ll get out of your hair.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1067dc25-ae20-4f3f-a9c0-146f70a13757">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="29208db9-b4d5-4b15-a3b4-69038fc1f1a7">
      <Text>Vinyl, they look like they all lost their hair.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c6e1e995-b59a-426f-8012-7fb8650b607c">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="63e3c965-1169-434a-a1e0-be2e730500d8">
      <Text>Hey now. It’s not our fault you’re losing your hair, motor control, or sense of self. Don’t pit the blame on us!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="60212599-7769-4a59-b4a6-4ef4c6950e26">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d882f918-2146-42bf-8ec7-7108da74e348">
      <Text Style="Italic">Blame it on Ohio</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b8604a2c-c3ed-4c73-bc1a-20a99f3ae0f3">
      <Text>The mob seems disgruntled.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d17d6746-1c41-4944-b5d3-416e4b5d4bd7">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="27de6538-e452-4ad5-8b06-4f31aa346d2a">
      <Text Style="Italic">Oh</Text>
      <Text>, </Text>
      <Text Style="Italic">they don’t seem to like that</Text>
      <Text>... Well, we’re just here living.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5222f3f1-4614-4c6d-8fea-fc01aa83dd9f">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="34fda7cf-4bc9-42b0-a532-dc4143014981">
      <Text>No, we’re not, Benzene. We’re not living in Ohio. People of Calcutta, where is the exit again?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e85ffadb-ec3a-4a99-91b9-fd660cd7f2d6">
      <Text>Benzene &amp; Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="eff52024-68e4-4e05-9136-ed06a96fbdb1">
      <Text Style="Italic">Right</Text>
      <Text>... </Text>
      <Text Style="Italic">East</Text>
      <Text>. </Text>
      <Text AdornmentStyle="-1">Ope</Text>
      <Text>, excuse us. We’ll be on our way. You all are the ones with toxicity in your hearts.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="80fdfab5-5e8c-445c-a996-da09aaf2bf76">
      <Text Style="AllCaps">Benzene</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text> walk east.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a064ee30-7732-4e62-adb5-422710667ec4">
      <Text>Benzene &amp; Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cc41031d-a24a-4f1a-a7ca-05b4959feae8">
      <Text>Everyone treats us like we’re toxic!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5d202ad1-a6c5-49c8-a606-af1257772f4f">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ebfc05dc-cfd9-4f1c-a24f-5bf6779330ef">
      <Text>I thought their hearts would melt for a romantic comedy gesture. After all, we gave each and everyone of them a </Text>
      <Text Color="#00000000FEFE">150-degree fever</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a29620c0-3001-4300-ac8a-1d631a7f447a">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="29820257-22ad-4c4e-9f2b-626e86fb2a5a">
      <Text>Romantic? How funny. We haven’t crossed that bridge yet...</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="ffb845bc-ad1d-42f6-8e0c-c998fc971651">
      <Text Style="Bold+Underline+AllCaps">Scene 7</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="a597b76e-fdd2-44b6-bf6d-dadd4cb54615">
      <SceneProperties Length="7/8" Page="24" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BENZENE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Bridge to PENNSYLVANIA</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b1d5a565-62e8-484d-9063-2e48a4b12da6">
      <Text>The bridge is foggy.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="dcd5d957-3760-4a2a-9ec2-9ef45681d30b">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8c7287ce-e1d6-4aec-994f-cfb6cf77bab3">
      <Text>The bridge to Pennsylvania!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="676140b3-6cfd-42fe-89ad-c62399884422">
      <Text Style="AllCaps">Benzene</Text>
      <Text> nabs the </Text>
      <Text AdornmentStyle="-1">PVC</Text>
      <Text> pipes.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c7a6efa8-df9b-4fcf-8664-ce3345973950">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c6e8b48f-3152-466a-95b6-119c5c12b2ea">
      <Text>It’s the Vinyl countdown!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9477f66b-a504-4444-a5bc-35327004f384">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> steals back the </Text>
      <Text AdornmentStyle="-1">PVC</Text>
      <Text> pipes.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5f4581a3-9fc5-4b31-927d-dc8a03bc42e9">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bf32eea7-1c94-44d8-97f1-e08699da3b87">
      <Text>Benzene, you can count on it.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a19ddf15-d816-4034-a5c2-34446c2ff891">
      <Text>BenZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3034316c-c9b0-4813-afd6-1fa498c668fe">
      <Text>We’re going to get out of Ohio?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8e371a1b-cf84-4b74-b89a-b43f71eddeec">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1728edf4-9f38-4f96-9d90-3a9e0adab03a">
      <Text>Out of this shithole.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6df91ff1-26d1-4470-9f28-7ba4b3827385">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="06d8287f-f4e8-4aaa-a64a-85d59502a2f6">
      <Text>We have to go through such shitting weather though...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0ad2ebd1-83e2-43de-8e97-b9595c9be82b">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4ffde5ef-9fa7-4fe9-ac50-a526fe5883f0">
      <Text>No shit, this fog.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d7d4cffa-bd26-480e-8c5d-3d9e9abd7c41">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="75581b2f-c507-419c-a159-2f83dce639b3">
      <Text>The notion of patience, it’s virtue.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f2bf513a-8347-4ca2-8646-85c0fa86033d">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0e111373-0c1f-46be-a407-1ffa154fabb9">
      <Text>You want to stay another second in Ohio?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8af408e5-6291-4052-9c67-92e032b808e9">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3799c539-7edb-438b-91f2-6528c652d68e">
      <Text>We have a ways to go before our atomic structure decays.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5c94f717-5c10-4875-a577-bcf618b54948">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ece20427-ceb4-4e58-a311-d57bad0ad98e">
      <Text>We will not stay another day, another minute, another second. Today, Benzene, today.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d465b64d-b97c-4990-9dc7-15b7a48508b1">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ad34db63-eca6-4044-b498-4bfb8cf384b7">
      <Text>Then, let’s go this way...</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="d0b174a0-77ff-4d76-9a8a-1265ef6b8c77">
      <SceneProperties Length="1 2/8" Page="25" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BENZENE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline+AllCaps">7. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">I See Myself With YOu</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0439619a-4e95-42d4-a5ca-2427b1385a71">
      <Text Style="AllCaps">Benzene</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text> wander through the foggy bridge.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="beb9cf3d-ab14-4763-8e4f-75db6b9d804f">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="cffdd046-97d8-449c-83df-fc5ac6e5e3a8">
      <Text>I cannot see through this fog!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d0c76629-7502-46af-a4b1-696d0a4f3713">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="6dc5cf7b-9b72-4997-9b72-a756df441d61">
      <Text>Well, I can still see through you!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e40277c9-073f-4c2c-b304-9165a2f222d3">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> playfully runs into the fog, leaving </Text>
      <Text Style="AllCaps">Benzene</Text>
      <Text> all alone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a44dfdf9-4f1a-4860-bfba-f89f0d5e28c2">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e9f1869e-675c-4f8b-ac9a-3d5919f845f3">
      <Text>Free-spirited lovers can be the worst!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f74465b4-ca7f-4b65-9f37-347f4c4ae88b">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9d9b8697-6907-4c46-820a-79df93cdd2e4">
      <Text>Speak for yourself. Do not worry because you smell like gas! It’s impossible to lose you!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7e657ec9-d4f6-4b2a-87f4-d13949a17a69">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1f6ddbff-15f8-4429-9c5b-6873243b0b84">
      <Text>Really, </Text>
      <Text AdornmentStyle="-1">PVC</Text>
      <Text> fart? Because you lost me here.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9d70ebde-5b4c-4d96-adbd-af2c0aaf5e67">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="147040ca-9dee-4ac0-8866-d5307af928ea">
      <Text>No way. We’ve been together for a moment. But we do need time on our own to see clearly again.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="53bc9db1-d555-4a9d-b370-35f09b01a09d">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1e297daf-46cb-478a-a6cd-be0f2970d0a2">
      <Text>I cannot even see myself...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="306c8078-0d1b-467d-b84a-93a7e4c4607a">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4aa5cf1d-2cb9-4d08-bab2-9ed5affcc181">
      <Text>We’ll cross this bridge when we get to it.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c85f0f6a-48ce-4192-b76e-20bb94d62ceb">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="413f2d61-a03a-420b-957e-d0b3b0a30d6d">
      <Text>I am small. I am too small. Too small for light that I cannot see it. I lack the complexity of sight. I am small. I am so small. So small I am always an oversight. I am tiny to this world. I am very small. There is atomic will. Free will in these condensed matters. The fog is nothing.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5347b16f-3c0f-496a-abd5-dbdf461bfea8">
      <Text Style="AllCaps">Benzene</Text>
      <Text> meditates.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7a633e8b-b477-4399-9ef2-e50422372d22">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8150666f-7cd5-4957-bc09-4934a4dc5af2">
      <Text>The fog is nothing. I can see through this fog, beyond the murky molecules. I am Benzene. I can feel clearly the cues. Vinyl’s cues. I want to adopt gay frogs with you! As many gay frogs as we want! We didn’t just fall in the river, we fell in love.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3da710d3-c45b-4a0a-bf2e-b8f6115b2695">
      <Text Style="AllCaps">Vinyl</Text>
      <Text>’s guitar echoes.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="609024ac-1b49-4a48-aa4a-a278ecdfa74c">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="949dfdad-cf5b-40a6-853c-a9590ed5d2b7">
      <Text>I see myself with...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="954dc49c-6c0f-4f69-b1c8-3cb4a4bea938">
      <Text>The fog clears up. They soon see </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text> at the end of the bridge.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="95d46553-d8e2-4743-b3ad-af0e59240da4">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="dd9f4c24-dd92-4d3f-b444-deb7b77442f7">
      <Text>I see myself with y-</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a4d407a1-9dcd-452e-87ec-ae78faa470ee">
      <Text>The </Text>
      <Text Style="AllCaps">eagle</Text>
      <Text> returns with a cry. They swoop in and push </Text>
      <Text Style="AllCaps">Benzene</Text>
      <Text> off the bridge and onto the grounds below.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="3ec94119-b14c-49d0-84e9-07dbd6e93a71">
      <SceneProperties Length="1/8" Page="26" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text Style="Underline+AllCaps">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">I See Myself With You</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="6ebb5ce5-6358-462a-bf91-c2daf0748331">
      <Text Style="Bold+Underline+AllCaps">Scene 8</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="c7e4498d-93b2-40de-a994-db4d242bf491">
      <SceneProperties Length="1/8" Page="26" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Backward Ohio</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="9c8486f8-8c4b-4690-9fb9-34ef21c6151f">
      <SceneProperties Length="1 7/8" Page="26" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BENZENE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="BENZENE &amp; VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MOTHER NATURE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline+AllCaps">8. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Airborne (Love’s in the Air)</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e26fb035-cd8a-48cd-ae13-28225467e6a6">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> runs down to find </Text>
      <Text Style="AllCaps">Benzene</Text>
      <Text>, lifeless in the soil.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="51754c71-5001-4b29-aebe-8ccf3592d711">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5213bfc1-df7c-426f-b43e-a13a66ea52cb">
      <Text>Benzene!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="aa0e952f-9798-4edc-9ac8-34ac95c51c80">
      <Text>Mother Nature (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b890d978-80bd-4fe0-a3b6-a2cf450d1c6d">
      <Text>I told ya. Mother Nature knows best.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="58d63519-f540-4a35-b405-450ad362592a">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="da5d5787-6c04-465c-9679-56a31a6cd532">
      <Text>Fuck you, Mother Nature!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5d8ce97b-c96d-46dd-bacb-8fb1e9b49e61">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> tries to lift up </Text>
      <Text Style="AllCaps">Benzene</Text>
      <Text>, but </Text>
      <Text Style="AllCaps">Benzene</Text>
      <Text> is too heavy.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bfbcd328-781a-4d9a-9601-774c9a384776">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d497095c-bae6-43ab-8b15-513b200fbece">
      <Text>Why ya </Text>
      <Text AdornmentStyle="-1">gotta</Text>
      <Text> weigh six carbon, hydrogen atoms?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d3446a43-9b0b-42fc-94ae-407e72bdab9a">
      <Text>MoTHER NATURE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="65ac44e7-5d64-40fa-bfb7-0fbb852e9ce9">
      <Text>I stopped you on land. I stopped you in water.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="db1ea4a1-ca0a-4ade-9767-7dafcd5eb6c8">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="eda4f8e8-8daf-4ad8-bf42-ded0a5300240">
      <Text>(Tearfully)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d497095c-bae6-43ab-8b15-513b200fbece">
      <Text>Our water didn’t last... Benzene, you may be insoluble in water, but what about my tears?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="093b2cf0-64d2-4823-b1bd-a5bd45e9ef6c">
      <Text>MoTHER NATURE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="577ac814-3f98-4a62-a65e-c395750c5baf">
      <Text>You two are my kidney stones and I’m ready to relieve myself of you cancers!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="32023407-3cee-41bb-b701-de25ae18296a">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> sees two rocks by </Text>
      <Text Style="AllCaps">Benzene</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="34c59dd0-71a8-47fd-b8dc-dae5f52b28ce">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e8247197-3cd3-46b4-8a53-db8d581a7e87">
      <Text>Our train ride is not over, Mother Nature. Here is our last stop.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6e1ac87b-3f7b-4717-8e4e-e2037772adfc">
      <Text>Mother Nature (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c574d189-566a-4886-b86b-71c836c4a055">
      <Text>Indeed. You’re right on track to your end.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ef5e5743-8785-461e-95ea-3d38b1a1e125">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e8247197-3cd3-46b4-8a53-db8d581a7e87">
      <Text>It’s the start. Air is your last chance to be reborn. I just need to strike a chord. A match. Long live Benzene and Vinyl...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6de0caa9-7f15-4b6c-ac29-404a5bb186e0">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> hesitantly holds the rocks.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1f76ebfd-541c-4397-9966-aafe8a79267d">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="5d1f1827-eb36-446b-882a-aabd50da440f">
      <Text>Rest warmly, my love.
They will see our...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bd4dc478-ea84-4548-9a85-61de933d9c20">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="03e8b5b2-e187-435e-a4c8-400341852448">
      <Text>(Dying)</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c7297e99-c7a0-41a8-8de9-7930b975a6ad">
      <Text>Light...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ac0e2e3b-5522-4773-82c8-5ca456313f45">
      <Text>VinYL</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="2883c04f-6c57-44d8-9af6-e8654fdb0164">
      <Text>Light.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1bce4ace-860f-4d6f-beb7-e66ecb465cce">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> strums the rocks, which sets everything ablaze.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e5127a81-69ce-4f0f-88c6-30b131b575f2">
      <Text>The </Text>
      <Text Style="AllCaps">eagle</Text>
      <Text> burns and falls out of the sky.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="21d6e43f-e4f7-42fa-8245-d4b87e9160d9">
      <Text Style="AllCaps">Benzene</Text>
      <Text> is risen.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f9b26a8d-5929-4d6c-b927-18603bedda72">
      <Text>Mother NATURE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="15e88628-d658-41ae-9228-de2a43b4444f">
      <Text>(Coughing and choking)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fa261276-2f40-47b0-ae9e-c4a542af8a32">
      <Text AdornmentStyle="-1">Fwhaoeghwoeanevewoaruwoeirhewaofhoewahfoewhfow</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="84e792f2-90d2-4c01-ae21-e5287272f55f">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="e485a61f-17a6-42b7-b807-571c52f7c476">
      <Text>Love’s in the air!

Suck on that, suck on these, Mother fucking Nature!
Ya boomer!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="237a525b-24fe-4e54-844d-0bdf59934cbb">
      <Text>As </Text>
      <Text Style="AllCaps">Benzene</Text>
      <Text> phases into the air, they use their remaining life force to tug on </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0e69e2b9-f552-4f6d-8ed2-1f7c919f288b">
      <Text>BeNZENE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="160f7760-dcf8-4cb5-8aea-a6ea811bc29a">
      <Text>Love, to the air?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="eb04185b-b34b-44f1-8f9a-b1c7e59f4b63">
      <Text Style="AllCaps">Vinyl</Text>
      <Text> accepts </Text>
      <Text Style="AllCaps">Benzene</Text>
      <Text>’s orbital.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="4f138fef-1d0c-47de-b9fc-6471aa4013cd">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="0deb84ec-fa72-43c1-9f77-cd88aa7074c3">
          <Text>Benzene</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="48e1f336-e87a-4414-b400-6ca624203ecf">
          <Text>We are airborne!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="9b86564b-0b00-46ab-92f7-7f4695665726">
          <Text>Vinyl</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="05d2a61c-7130-425a-9886-578fb1bceded">
          <Text>Let’s get airborne!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="f1aca11c-5de6-42f2-b516-f481a7566998">
      <Text>The fire swallows up </Text>
      <Text Style="AllCaps">Benzene</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text>. The two </Text>
      <Text Style="AllCaps">chemicals</Text>
      <Text> become one with the rainbowy air.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f1aca11c-5de6-42f2-b516-f481a7566998">
      <Text>Ohio burns down.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7e2b02cd-d39e-487f-9303-d66846f569a5">
      <Text>BENZENE &amp; VinYL</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="ca2099d7-4a7c-466e-bc39-89c4cb3f834d">
      <Text>There’re chemicals in this fire making our hearts gay!
</Text>
      <Text AdornmentStyle="-1">Friggin</Text>
      <Text>’ gay!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="fddbd19d-5951-4e5b-b30d-53e043cf82cb">
      <Text Style="AllCaps">Benzene</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Vinyl</Text>
      <Text> adopt </Text>
      <Text Style="AllCaps">gay frogs</Text>
      <Text>. Rainbow-out.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="ba93bb5b-c176-4151-ab75-c44b6b82f3b4">
      <Text Style="Underline">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Airborne (Love’s in the Air)</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="End of Act" id="55a01105-b054-4b11-8fa9-f7d398474bca">
      <Text>End of Ohio</Text>
    </Paragraph>
  </Content>

